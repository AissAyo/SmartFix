{% extends 'base.html.twig' %}

{% block title %}Client{% endblock %}

{% block body %}
    <h1>Client</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ client.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ client.name }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ client.password }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ client.email }}</td>
            </tr>
            <tr>
                <th>Logo</th>
                <td>{{ client.logo }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ client.roles ? client.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>ResetToken</th>
                <td>{{ client.resetToken }}</td>
            </tr>
            <tr>
                <th>TokenExpiration</th>
                <td>{{ client.tokenExpiration ? client.tokenExpiration|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Username</th>
                <td>{{ client.username }}</td>
            </tr>
            <tr>
                <th>VerificationStatus</th>
                <td>{{ client.verificationStatus ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>DateInscription</th>
                <td>{{ client.dateInscription ? client.dateInscription|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>LoyaltyPoints</th>
                <td>{{ client.loyaltyPoints }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_crud_client_index') }}">back to list</a>

    <a href="{{ path('app_admin_crud_client_edit', {'id': client.id}) }}">edit</a>

    {{ include('admin_crud_client/_delete_form.html.twig') }}
{% endblock %}
