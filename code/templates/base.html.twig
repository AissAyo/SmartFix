<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}SmartFix{% endblock %}</title>
    {% block stylesheets %}
      {# <link rel="stylesheet" href="{{ asset('build/app.css') }}"> #}
    {% endblock %}
  </head>
  <body>
    <header>
      {% block header %}
        <h1>SmartFix Platform</h1>
      {% endblock %}
    </header>

    <main>
      {% block body %}
        <p>Default content.</p>
      {% endblock %}
    </main>

    <footer>
      {% block footer %}
        <p>&copy; 2025 SmartFix</p>
      {% endblock %}
    </footer>

    {% block javascripts %}
      {# <script src="{{ asset('build/app.js') }}"></script> #}
    {% endblock %}
  </body>
</html>
