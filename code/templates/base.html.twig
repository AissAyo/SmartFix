    <!DOCTYPE html>
    <html lang="en">
    <head>
            {% block head %}
                    <meta charset="UTF-8">
                    <title>{% block title %}Welcome To SmartFix!{% endblock %}</title>

                    <link rel="icon" href="data:image/svg+xml,
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'>
                <text y='1.2em' font-size='96'>⚫️</text>
                <text y='1.3em' x='0.2em' font-size='76' fill='#fff'>sf</text>
            </svg>">
            {% endblock %}

            {% block stylesheets %}
                    {{ encore_entry_link_tags('app') }}
            {% endblock %}
    </head>

    <body>
    {% block body %}
            {% block header %}{% endblock %}
            {% block darkmode %}{% endblock %}
            {% block menu %}{% endblock %}
            {% block container %}{% endblock %}
            {% block chat %}{% endblock %}
            {% block footer %}{% endblock %}


            {% block javascripts %}
                    {{ encore_entry_script_tags('app') }}
                    {% block extra_javascripts %}{% endblock %}
            {% endblock %}
    {% endblock %}
    </body>
    </html>
