{% extends 'layout.html.twig' %}

{% block title %}Password Reset{% endblock %}

{% block container %}
    <main>
        <section class="pd-bottom-300">
            <div class="container">
                <div class="wptb-login-form">
                    <div class="wptb-form--wrapper">
                        <div class="row">
                            <div class="col-lg-8 col-md-10 offset-lg-2 offset-md-1">
                                {# Display flash messages #}
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                {% for message in app.flashes('error') %}
                                    <div class="alert alert-danger">
                                        {{ message }}
                                    </div>
                                {% endfor %}

                                <div class="wptb-heading">
                                    <div class="wptb-item--inner">
                                        <h1 class="wptb-item--title">Password Reset</h1>
                                    </div>
                                </div>

                                {# Start the form with the token passed as parameter #}
                                {{ form_start(form, { 'action': path('app_reset_password', { 'token': token }) }, { 'attr': { 'class': 'wptb-form' } }) }}

                                <div class="wptb-form--inner">
                                    <div class="row">
                                        <div class="col-12">
                                            {{ form_row(form.password, {
                                                'label': 'New Password',
                                                'attr': {
                                                    'placeholder': 'Enter your new password'
                                                }
                                            }) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_row(form.confirmPassword, {
                                                'label': 'Confirm Password',
                                                'attr': {
                                                    'placeholder': 'Confirm your new password'
                                                }
                                            }) }}
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary">Reset Password</button>
                                        </div>
                                    </div>
                                </div>

                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
