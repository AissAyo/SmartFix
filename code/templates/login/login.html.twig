{% extends 'layout.html.twig' %}

{% form_theme login_form 'form/security/login.html.twig' %}

{% block title %}Login{% endblock %}

{% block container %}
    <main>
        <section class="pd-bottom-300">
            <div class="container">
                <div class="wptb-login-form">
                    <div class="wptb-form--wrapper">
                        <div class="row">
                            <div class="col-lg-8 col-md-10 offset-lg-2 offset-md-1">
                                {# Display flash messages #}
                                {% for message in app.flashes('error') %}
                                    <div class="alert alert-danger">
                                        {{ message }}
                                    </div>
                                {% endfor %}

                                <div class="wptb-heading">
                                    <div class="wptb-item--inner">
                                        <h1 class="wptb-item--title">Login</h1>
                                    </div>
                                </div>

                                {{ form_start(login_form, { attr: {class: 'wptb-form'} }) }}

                                <div class="wptb-form--inner">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(login_form.email, 'Email Address') }}
                                                {{ form_widget(login_form.email, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': 'Enter your email'
                                                    }
                                                }) }}
                                                {{ form_errors(login_form.email, {'message': 'Invalid email address'}) }}
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(login_form.password, 'Password') }}
                                                {{ form_widget(login_form.password, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': 'Enter your password'
                                                    }
                                                }) }}
                                                {{ form_errors(login_form.password, {'message': 'Incorrect email or password'}) }}
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-lg-12">
                                            <div class="wptb-item--button mt-4">
                                                <button class="btn-two white" type="submit">
                                                    <div class="btn-wrap">
                                                        <span class="text-first">Login</span>
                                                        <span class="text-second"><i class="bi bi-plus"></i></span>
                                                    </div>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {{ form_end(login_form) }}

                                <p class="mt-4">
                                    <a href="{{ path('app_forgot_password') }}">Forgot password?</a>
                                </p>
                                <p class="mt-4">
                                    <a href="{{ path('app_register_client') }}">Don't have an account</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
