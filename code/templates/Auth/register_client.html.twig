{% extends 'base.html.twig' %}

{% block title %}Sign Up{% endblock %}

{% block container %}
    <main>
        <section class="pd-bottom-300">
            <div class="container">
                <div class="wptb-signup-form">
                    <div class="wptb-form--wrapper">
                        <div class="row">
                            <div class="col-lg-8 col-md-10 offset-lg-2 offset-md-1">
                                {% for message in app.flashes('error') %}
                                    <div class="alert alert-danger">
                                        {{ message }}
                                    </div>
                                {% endfor %}

                                <div class="wptb-heading">
                                    <div class="wptb-item--inner">
                                        <h1 class="wptb-item--title">Sign Up</h1>
                                    </div>
                                </div>

                                {{ form_start(signup_form, { attr: {class: 'wptb-form'} }) }}

                                <div class="wptb-form--inner">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(signup_form.name, 'Full Name') }}
                                                {{ form_widget(signup_form.name, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': 'John Doe'
                                                    }
                                                }) }}
                                                {{ form_errors(signup_form.name) }}

                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(signup_form.email, 'Email Address') }}
                                                {{ form_widget(signup_form.email, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': 'your@email.com'
                                                    }
                                                }) }}
                                                {{ form_errors(signup_form.email) }}
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(signup_form.password, 'Password') }}
                                                {{ form_widget(signup_form.password, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': 'At least 8 characters'
                                                    }
                                                }) }}
                                                {{ form_errors(signup_form.password) }}

                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(signup_form.phone, 'Phone Number') }}
                                                {{ form_widget(signup_form.phone, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': '06 12 34 56 78'
                                                    }
                                                }) }}
                                                {{ form_errors(signup_form.phone) }}
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(signup_form.city, 'City') }}
                                                {{ form_widget(signup_form.city, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'placeholder': 'Casablanca'
                                                    }
                                                }) }}
                                                {{ form_errors(signup_form.city) }}
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(signup_form.profileImage, 'Profile Picture (optional)') }}
                                                {{ form_widget(signup_form.profileImage, {
                                                    'attr': {
                                                        'class': 'form-control'
                                                    }
                                                }) }}
                                                {{ form_errors(signup_form.profileImage) }}
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-lg-12">
                                            <div class="wptb-item--button mt-4">
                                                <button class="btn-two white" type="submit">
                                                    <div class="btn-wrap">
                                                        <span class="text-first">Sign Up</span>
                                                        <span class="text-second"><i class="bi bi-plus"></i></span>
                                                    </div>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <p class="mt-4">
                                    <a href="{{ path('app_login') }}">Already have an account? Login here</a>
                                </p>

                                {{ form_end(signup_form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}