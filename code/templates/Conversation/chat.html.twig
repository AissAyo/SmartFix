<!DOCTYPE html>
<html>
<head>
    <title>Chat - {{ conversation.getConversationType() }}</title>
    <script src="https://unpkg.com/@mercure/receiver@0.11.0/dist/mercure.js"></script>
</head>
<body>
<h1>Conversation #{{ conversation.id }}</h1>
<div id="messages">
    {% for message in messages %}
        <div class="message {% if message.getSender() == app.user %}mine{% endif %}">
            {{ message.content }} ({{ message.sentAt|date('H:i') }})
        </div>
    {% endfor %}
</div>

<form id="message-form">
    <input type="text" id="message-input" placeholder="Type your message...">
    <button type="submit">Send</button>
</form>

<script>
    const hubUrl = '{{ mercure_publish_url }}';
    const topic = '{{ mercure_topic }}';
    const token = '{{ mercure_jwt_token }}';

    // Subscribe to updates
    const receiver = new Mercure.Receiver(hubUrl, token);
    receiver.subscribe(topic, (update) => {
        const message = JSON.parse(update.data);
        const messagesDiv = document.getElementById('messages');
        messagesDiv.innerHTML += `
                <div class="message ${message.sender.id === {{ app.user.id }} ? 'mine' : ''}">
                    ${message.content} (${new Date(message.sentAt).toLocaleTimeString()})
                </div>
            `;
    });

    // Send message
    document.getElementById('message-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('message-input');
        const content = input.value.trim();

        if (content) {
            await fetch('/message', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    conversation_id: {{ conversation.id }},
                    content: content
                })
            });
            input.value = '';
        }
    });
</script>
</body>
</html>