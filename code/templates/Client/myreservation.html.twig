{% extends 'layout.html.twig' %}

{% block container %}
    {# head #}
    <div class="wptb-page-heading" style="background-image: url('{{ asset('img/background/page-header-bg.jpg') }}');">
        <div class="container">
            <div class="wptb-item--inner">
                <h2 class="wptb-item--title">My Reservations</h2>
                <div class="wptb-breadcrumb-wrap">
                    <ul class="wptb-breadcrumb">
                        <li><a href="#">Home</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {# Table of Reservations for Mechanic #}
    <div class="col-lg-12 col-md-12 p-md-0">
        <div class="sidebar">
            <div class="wptb-project-info1">
                <h5 class="wptb-item--title"></h5>
                <div class="wptb--holder">
                    <table class="table table-bordered table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-dark">Client</th>
                                <th class="text-dark">Garage</th>
                                <th class="text-dark">Reservation Date</th>
                                <th class="text-dark">Status</th>
                                <th class="text-dark">Note</th>
                                <th class="text-dark">Vehicle</th>
                                <th class="text-dark">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {# Reservation 1 #}
                            <tr>
                                <td class="text-dark">John Doe</td>
                                <td class="text-dark">ABC Garage</td>
                                <td class="text-dark">15/07/2023</td>
                                <td class="text-dark">Pending</td>
                                <td class="text-dark">Request for oil change</td>
                                <td class="text-dark">Toyota Corolla</td>
                                <td>
                                    <a href="#" class="btn btn-primary btn-sm">
                                        <i class="bi bi-check-circle"></i> Accept
                                    </a>
                                    <a href="#" class="btn btn-danger btn-sm">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </a>
                                </td>
                            </tr>
                            {# Reservation 2 #}
                            <tr>
                                <td class="text-dark">Jane Smith</td>
                                <td class="text-dark">XYZ Garage</td>
                                <td class="text-dark">20/07/2023</td>
                                <td class="text-dark">Pending</td>
                                <td class="text-dark">Need tire replacement</td>
                                <td class="text-dark">Honda Civic</td>
                                <td>
                                    <a href="#" class="btn btn-primary btn-sm">
                                        <i class="bi bi-check-circle"></i> Accept
                                    </a>
                                    <a href="#" class="btn btn-danger btn-sm">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </a>
                                </td>
                            </tr>
                            {# Reservation 3 #}
                            <tr>
                                <td class="text-dark">Robert White</td>
                                <td class="text-dark">CarFix Garage</td>
                                <td class="text-dark">25/07/2023</td>
                                <td class="text-dark">Pending</td>
                                <td class="text-dark">Engine check</td>
                                <td class="text-dark">Ford Focus</td>
                                <td>
                                    <a href="#" class="btn btn-primary btn-sm">
                                        <i class="bi bi-check-circle"></i> Accept
                                    </a>
                                    <a href="#" class="btn btn-danger btn-sm">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block styles %}
    <style>
        /* Smaller button size */
        .btn {
            padding: 6px 12px;  /* Reduced padding */
            font-size: 14px;  /* Slightly smaller font */
            border-radius: 4px; /* Rounded corners */
        }

        /* Soft colors for buttons */
        .btn-primary {
            background-color: #007bff; /* Softer blue */
            border-color: #007bff;
        }

        .btn-danger {
            background-color: #dc3545; /* Softer red */
            border-color: #dc3545;
        }

        /* Button hover effect */
        .btn:hover {
            background-color: #0056b3; /* Darker blue for hover */
            border-color: #004085; /* Darker border for hover */
            transform: scale(1.05); /* Slight zoom */
        }

        .btn-danger:hover {
            background-color: #c82333; /* Darker red for hover */
            border-color: #bd2130; /* Darker red border for hover */
        }

        /* Table row hover effect */
        tr:hover {
            background-color: #f8f9fa; /* Light gray for light mode */
        }

        /* Header Styling */
        .thead-light th {
            background-color: #f8f9fa; /* Light background for the header */
            color: #212529; /* Dark text for header */
        }

        /* Table body styling */
        td, th {
            color: #212529; /* Dark text for the content */
        }
    </style>
{% endblock %}
