{% extends 'layout.html.twig' %}
{% block content %}
    <h2>Services disponibles</h2>

    {% for service in garageServices %}
        <div class="service-card">
            <h3>{{ service.name }}</h3>
            <p><strong>Garage :</strong> {{ service.garage.name }}</p>

            <h4>Commentaires :</h4>
            <ul>
                {% for review in service.reviews %}
                    <li>{{ review.comment }} (note : {{ review.rating }})</li>
                {% else %}
                    <li>Aucun commentaire pour ce service.</li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <p>Aucun service trouvé.</p>
    {% endfor %}
{% endblock content %}