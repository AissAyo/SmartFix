{% extends 'layout.html.twig' %}
{% block container %}

        <main class="wrapper">
            <div class="wptb-page-heading" style="background-image: url('assets/img/background/page-header-bg.jpg');">
                <div class="container">
                    <div class="wptb-item--inner">
                        <h2 class="wptb-item--title ">Services</h2>
                        <div class="wptb-breadcrumb-wrap">
                            <ul class="wptb-breadcrumb">
                                <li><a href="#">Home</a></li>
                                <li><span>services</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <section class="wptb-shop pd-bottom-300">
                <div class="container">
                    <div class="row">

                        <div class="col-lg-9 col-md-8 pe-md-5">
                            <div class="shop_filtering_method d-flex align-items-center flex-wrap">
                                <div class="view_type_wrapper d-flex align-items-center">
                                    <ul class="nav view_type d-flex align-items-center">
                                        <li>
                                            <a class="icon-grid active" id="grid-tab" data-bs-toggle="tab" href="#grid"><i class="bi bi-grid-3x3-gap-fill"></i></a>
                                        </li>
                                        <li>
                                            <a class="icon-list" id="list-tab" data-bs-toggle="tab" href="#list"><i class="bi bi-list-task"></i></a>
                                        </li>
                                    </ul>
                                    <div class="showing_results">
                                        Showing 1-12 of 42 results
                                    </div>
                                </div>
                                <div class="sorting_wrapper">
  <div class="sorting_select">
    <select class="basic_select" id="citySelect">
      <option value="">Select a City</option>
    </select>
  </div>
  <input type="text" id="citySearch" class="basic_select mb-2 mt-2" placeholder="Search for a city..." style="width: 100%; padding: 8px; display: none;">
</div>
                               
                                   
                                    <div class="sorting_select">
    <form method="get" action="{{ path('mecanics') }}" id="vehicleForm">
        <select class="basic_select" id="vehicleSelect" name="vehicleId" onchange="document.getElementById('vehicleForm').submit()">
            <option value="0">Select Cart</option>
            {% for vehicule in vehicules %}
                <option value="{{ vehicule.id }}" {% if selectedVehicle is defined and selectedVehicle.id == vehicule.id %}selected{% endif %}>
                    {{ vehicule.brand }}
                </option>
            {% endfor %}
        </select>
    </form>
</div>



                                </div>
                            </div>

<div class="tab-content">
    <div class="tab-pane fade active show" id="grid" role="tabpanel" aria-labelledby="grid-tab">
        <div class="product_view_grid product_col_3">

            {% for garageService in garageServices %}
                <div class="product_item">
                    <div class="product_thumb">
                        <span class="badge-sale">Sale</span> {# tu peux adapter ici selon la logique #}
                        <div class="product_imagebox">
                            <img class="primary_img" src="assets/img/shop/1.png" alt="img">
                            <div class="cart_button">
                                <a href="#" class="btn">Add to Cart</a>
                            </div>
                        </div>
                        <div class="product_item_inner">
                            <div class="label_text">
                                <h2 class="product_item_name">
                                    <a href="#">{{ garageService.service.serviceName }}</a>
                                </h2>
                                <div class="product_item_rating">
                                    <ul>
                                        {% for i in 1..5 %}
                                            <li>
                                                <i class="bi {{ i <= garageService.averageRating ? 'bi-star-fill' : 'bi-star' }}"></i>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div class="product_item_price">
                                    {{ garageService.price|number_format(2, '.', ',') }}€
                                    {# Tu peux aussi afficher l'ancien prix ici si besoin avec <del> #}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-center">Aucun service trouvé.</p>
            {% endfor %}

            <div class="wptb-pagination-wrap text-center">
                <ul class="pagination">
                    <li>
                        <a class="page-number previous {% if currentPage <= 1 %}disabled{% endif %}" href="?page={{ currentPage > 1 ? currentPage - 1 : 1 }}{% if selectedVehicle is defined %}&vehicleId={{ selectedVehicle.id }}{% endif %}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    {% if totalPages > 1 %}
                        {% if currentPage > 3 %}
                            <li><span class="page-number">1</span></li>
                            <li><span>.....</span></li>
                        {% endif %}

                        {% for page in 1..totalPages %}
                            {% if page >= currentPage - 2 and page <= currentPage + 2 %}
                                <li>
                                    <span class="page-number {% if page == currentPage %}current{% endif %}">
                                        <a href="?page={{ page }}{% if selectedVehicle is defined %}&vehicleId={{ selectedVehicle.id }}{% endif %}">{{ page }}</a>
                                    </span>
                                </li>
                            {% endif %}
                        {% endfor %}

                        {% if currentPage < totalPages - 2 %}
                            <li><span>.....</span></li>
                            <li><span class="page-number">
                                <a href="?page={{ totalPages }}{% if selectedVehicle is defined %}&vehicleId={{ selectedVehicle.id }}{% endif %}">{{ totalPages }}</a>
                            </span></li>
                        {% endif %}
                    {% else %}
                        <li><span class="page-number current">1</span></li>
                    {% endif %}

                    <li>
                        <a class="page-number next {% if currentPage >= totalPages %}disabled{% endif %}" href="?page={{ currentPage < totalPages ? currentPage + 1 : totalPages }}{% if selectedVehicle is defined %}&vehicleId={{ selectedVehicle.id }}{% endif %}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</div>

                            <!-- Sidebar  -->
                        <div class="col-lg-3 col-md-4 p-0 mt-5 mt-md-0">
                            <div class="shop_sidebar">
								

    <div class="widget">
        <h2 class="widget-title">Services</h2>
        <ul class="sidebar_category">
            {% if categories is defined and categories is not empty %}
                {% for category in categories %}
                    <li class="category_item">
                        <div class="category_item_inner">
                            <div class="cat_name">
                                <a href="#">{{ category.Categoryname }}</a>
                            </div>
                            <span class="cat_toggler">
                            <a data-bs-toggle="collapse" href="#{{ loop.index }}_services" aria-expanded="false" aria-controls="{{ loop.index }}_services">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </span>
                        </div>
                        <ul id="{{ loop.index }}_services" class="child_category collapse">
                            {% for service in category.services %}
                                <li>
                                    <div class="cat_name">
                                        <a href="#" onclick="filterByService({{ service.Id }})">{{ service.serviceName }}</a>
                                    </div>
                                </li>
                            {% else %}
                                <li class="no-services">Aucun service dans cette catégorie.</li>
                            {% endfor %}    
                        </ul>
                    </li>
                {% endfor %}
            {% else %}
                <li class="no-categories">
                    <div class="cat_name">Aucune catégorie de services disponible.</div>
                </li>
            {% endif %}
        </ul>
    </div>


								<div class="widget">
									<h2 class="widget-title">
                                        Price Filter
                                    </h2>
                                    <div class="sidebar_price_filter">
                                        <div id="slider-range" class="range-bar"></div>
                                        <div class="range-value d-flex justify-content-end">
                                            <span>Price:</span> <input type="text" id="amount" readonly />
                                        </div>
                                	</div>
                                </div>


                                <div class="widget">
                                    <h2 class="widget-title">
Top rated garages                                    </h2>

                                    <div class="products-list">
                                        <ul class="popular_product_list">
                                            <li class="popular_product_item">
                                                <div class="popular_product_image">
                                                    <img class="primary_img" src="assets/img/shop/1.png" alt="">
                                                </div>
                                                <div class="popular_product_content">
                                                    <h5 class="product_title"><a href="shop-product.html">Oil Filters</a></h5>
                                                    <h6 class="product_price">$45 <del>49.99</del></h6>
                                                </div>
                                            </li>
                                            <li class="popular_product_item">
                                                <div class="popular_product_image">
                                                    <img class="primary_img" src="assets/img/shop/2.png" alt="">
                                                </div>
                                                <div class="popular_product_content">
                                                    <h5 class="product_title"><a href="shop-product.html">Transmission cog wheels</a></h5>
                                                    <h6 class="product_price">$67</h6>
                                                </div>
                                            </li>
                                            <li class="popular_product_item">
                                                <div class="popular_product_image">
                                                    <img class="primary_img" src="assets/img/shop/3.png" alt="">
                                                </div>
                                                <div class="popular_product_content">
                                                    <h5 class="product_title"><a href="shop-product.html">Starter motor</a></h5>
                                                    <h6 class="product_price">$83</h6>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

								<div class="widget">
                                    <h2 class="widget-title">
                                        garage Tag
                                    </h2>
                                    <div class="wp-block-tag-list wp-block-tag">
                                        <a href="#" class="tag-cloud-link">Automobile</a>
                                        <a href="#" class="tag-cloud-link">Engine</a>
                                        <a href="#" class="tag-cloud-link">Carwash</a>
                                        <a href="#" class="tag-cloud-link">Detailing</a>
                                        <a href="#" class="tag-cloud-link">Mechanic</a>
                                        <a href="#" class="tag-cloud-link">Motor</a>
                                        <a href="#" class="tag-cloud-link">Speed</a>
                                    </div>
                                </div>

							</div>
                        </div>
                    </div>
                </div>

            </section>

        </main>
            {% endblock %}
