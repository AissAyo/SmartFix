{% use 'form/common/errors.html.twig' %}

{% block _login_form_email_row %}
    <div class="col-lg-12 col-md-12 mb-4">
        <div class="form-group">
            {{ form_widget(form, {
                attr: {
                    class: 'form-control',
                    placeholder: 'User Name or E-mail Address'
                }
            }) }}
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block _login_form_password_row %}
    <div class="col-lg-12 col-md-12 mb-4">
        <div class="form-group">
            {{ form_widget(form, {
                attr: {
                    class: 'form-control',
                    placeholder: 'Password'
                }
            }) }}
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

