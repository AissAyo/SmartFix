{% extends 'layout.html.twig' %}

{% block container %}
    <section class="wptb-testimonial-one bg-image" style="background-image: url('assets/img/background/bg-3.jpg');">
        <div class="container">
            <div class="wptb-heading">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="wptb-item--inner">
                            <h6 class="wptb-item--subtitle">
                                Clients Testimonial
                            </h6>
                            <h1 class="wptb-item--title"> What Our Clients Say
                                About Our Services<span>...</span> </h1>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="wptb-item--button text-md-end">
                            <a class="btn-two" href="contact-1.html">
                                        <span class="btn-wrap">
                                            <span class="text-first">See All Reviews</span>
                                            <span class="text-second"> <i class="bi bi-plus"></i> </span>
                                        </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="swiper-container swiper-testimonial swiper-initialized swiper-horizontal swiper-pointer-events swiper-backface-hidden">
                <!-- swiper slides -->
                <div class="swiper-wrapper">
                    {% for review in reviews %}
                    <div class="swiper-slide" style="width: 936px; margin-right: 30px;" role="group">
                        <div class="wptb-testimonial1">
                            <div class="wptb-item--inner">
                                <div class="wptb-item--image">
                                    <img src="assets/img/testimonial/3.jpg" alt="img">
                                    <div class="wptb-item--icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="57" height="45" viewBox="0 0 57 45" fill="none">
                                            <path d="M51.5137 38.5537C56.8209 32.7938 56.2866 25.3969 56.2697 25.3125V2.8125C56.2697 2.06658 55.9734 1.35121 55.4459 0.823763C54.9185 0.296317 54.2031 0 53.4572 0H36.5822C33.48 0 30.9572 2.52281 30.9572 5.625V25.3125C30.9572 26.0584 31.2535 26.7738 31.781 27.3012C32.3084 27.8287 33.0238 28.125 33.7697 28.125H42.4266C42.3671 29.5155 41.9517 30.8674 41.22 32.0513C39.7913 34.3041 37.0997 35.8425 33.2156 36.6188L30.9572 37.0688V45H33.7697C41.5969 45 47.5678 42.8316 51.5137 38.5537ZM20.5566 38.5537C25.8666 32.7938 25.3294 25.3969 25.3125 25.3125V2.8125C25.3125 2.06658 25.0162 1.35121 24.4887 0.823763C23.9613 0.296317 23.2459 0 22.5 0H5.625C2.52281 0 0 2.52281 0 5.625V25.3125C0 26.0584 0.296316 26.7738 0.823762 27.3012C1.35121 27.8287 2.06658 28.125 2.8125 28.125H11.4694C11.41 29.5155 10.9945 30.8674 10.2628 32.0513C8.83406 34.3041 6.1425 35.8425 2.25844 36.6188L0 37.0688V45H2.8125C10.6397 45 16.6106 42.8316 20.5566 38.5537Z" fill="#D70006"></path>
                                        </svg>
                                    </div>
                                </div>

                                <div class="wptb-item--holder">
                                    <div class="wptb-item--meta-rating">
                                        {% for i in 1..5 %}
                                            <i class="bi bi-star-fill {% if i <= review.rating %}text-warning{% endif %}"></i>
                                        {% endfor %}
                                    </div>

                                    <p class="wptb-item--description">"{{ review.comment }}"</p>
                                    <div class="wptb-item--meta">
                                        <div class="wptb-item--meta-left">
                                            <h4 class="wptb-item--title">{{ review.reservation.vehicle.client.name }}</h4>
                                            <h6 class="wptb-item--designation">Sydney</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}