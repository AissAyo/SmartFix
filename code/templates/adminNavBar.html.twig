{% block javascripts %}
    {{ parent() }}

    <script>
        document.querySelectorAll('.nav-item.has-treeview > a').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const submenu = this.nextElementSibling;
                submenu.style.display = submenu.style.display === 'none' ? 'block' : 'none';
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const toggleButton = document.getElementById("toggleSidebar");
            const sidebar = document.querySelector(".menu-container");

            toggleButton.addEventListener("click", function() {
                sidebar.classList.toggle("show"); // Toggle sidebar visibility
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $(".clickable").click(function (e) {
                e.preventDefault(); // Prevent the default link behavior

                let $submenu = $(this).next(".nav-treeview"); // Get the submenu
                let $arrow = $(this).find(".arrow"); // Get the arrow icon

                // Close other open menus (optional)
                $(".nav-treeview").not($submenu).slideUp(300);
                $(".clickable .arrow").not($arrow).removeClass("fa-angle-down").addClass("fa-angle-left");

                // Toggle submenu
                $submenu.slideToggle(300);

                // Toggle arrow direction
                $arrow.toggleClass("fa-angle-left fa-angle-down");
            });
        });



    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
