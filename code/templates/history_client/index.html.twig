{% extends 'layout.html.twig' %}

{% block container %}
    {# head #}
    <div class="wptb-page-heading" style="background-image: url('{{ asset('img/background/page-header-bg.jpg') }}');">
        <div class="container">
            <div class="wptb-item--inner">
                <h2 class="wptb-item--title">My Reservations</h2>
                <div class="wptb-breadcrumb-wrap">
                    <ul class="wptb-breadcrumb">
                        <li><a href="{{ path('app_home') }}">Home</a></li>
                        <li>My Reservations</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {# main content #}
    <div class="wptb-main-content">
        <div class="container">
            <div class="row">
                {# sidebar #}
                <div class="col-lg-3 col-md-4">
                    <div class="sidebar">
                        <div class="wptb-project-info1">
                            <h5 class="wptb-item--title">Reservation<br>History</h5>
                            <div class="wptb--holder">
                                <div class="wptb--item">
                                    <div class="wptb--meta"><label>Total Reservations:</label> <span>{{ pagination.getTotalItemCount }}</span></div>
                                </div>
                                <div class="wptb--item">
                                    <div class="wptb--meta"><label>Filter by Status:</label></div>
                                    <form method="get" class="mt-2">
                                        <select class="form-select" name="status" onchange="this.form.submit()">
                                            {% for value, label in statusOptions %}
                                                <option value="{{ value }}" {% if value == selectedStatus %}selected{% endif %}>{{ label }}</option>
                                            {% endfor %}
                                        </select>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# main content #}
                <div class="col-lg-9 col-md-8">
                    <div class="wptb-reservation-history">
                        {% if reservations|length > 0 %}
                            {% for reservation in reservations %}
                                <div class="wptb-reservation-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-3">
                                            <div class="wptb-reservation-date">
                                                <h6>{{ reservation.reservationDate|date('d M Y') }}</h6>
                                                <span>{{ reservation.reservationDate|date('H:i') }}</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="wptb-reservation-vehicle">
                                                <h6>{{ reservation.vehicle.plateNumber }}</h6>
                                                <span>{{ reservation.vehicle.model }}</span>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="wptb-reservation-service">
                                                {{ reservation.service.name }}
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="wptb-reservation-status">
                                                <span class="badge bg-{{ reservation.status|lower == 'completed' ? 'success' : (reservation.status|lower == 'pending' ? 'warning' : 'secondary') }}">
                                                    {{ reservation.status }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <div class="wptb-reservation-price">
                                                {{ reservation.estimatedPrice }} MAD
                                            </div>
                                        </div>
                                    </div>
                                    <div class="wptb-reservation-actions">
                                        {% if reservation.status|lower == 'completed' %}
                                            <a href="#" class="wptb-btn-review"
                                               data-id="{{ reservation.id }}"
                                               data-bs-toggle="modal"
                                               data-bs-target="#reviewModal">
                                                <i class="bi bi-star-fill"></i> Review
                                            </a>
                                        {% elseif reservation.status|lower == 'pending' %}
                                            <a href="{{ path('client_reservation_cancel', {id: reservation.id}) }}"
                                               class="wptb-btn-cancel"
                                               data-href="{{ path('client_reservation_cancel', {id: reservation.id}) }}">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}

                            {# pagination #}
                            <div class="wptb-pagination">
                                {{ knp_pagination_render(pagination) }}
                            </div>
                        {% else %}
                            <div class="wptb-no-reservations">
                                <p>No reservations found</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Review Modal #}
    <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewModalLabel">Leave a Review</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="wptb-review-form">
                        <div class="rating mb-3">
                            <input type="radio" name="rating" value="5" id="star5"><label for="star5"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="rating" value="4" id="star4"><label for="star4"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="rating" value="3" id="star3"><label for="star3"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="rating" value="2" id="star2"><label for="star2"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="rating" value="1" id="star1"><label for="star1"><i class="bi bi-star-fill"></i></label>
                        </div>
                        <div class="form-group">
                            <textarea class="form-control" id="reviewComment" rows="4" placeholder="Write your review here..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="wptb-btn wptb-btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="wptb-btn wptb-btn-primary" id="submitReview">Submit Review</button>
                </div>
            </div>
        </div>
    </div>

    {# Confirmation Modal #}
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">Confirm Cancellation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel this reservation?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="wptb-btn wptb-btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="button" class="wptb-btn wptb-btn-danger" id="confirmCancel">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .wptb-reservation-history {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0,0,0,0.05);
            padding: 30px;
        }

        .wptb-reservation-item {
            border-bottom: 1px solid #eee;
            padding: 20px 0;
            margin-bottom: 15px;
        }

        .wptb-reservation-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .wptb-reservation-date h6,
        .wptb-reservation-vehicle h6 {
            font-weight: 600;
            margin-bottom: 5px;
            color: #333;
        }

        .wptb-reservation-date span,
        .wptb-reservation-vehicle span {
            font-size: 14px;
            color: #777;
        }

        .wptb-reservation-service {
            font-weight: 500;
            color: #444;
        }

        .wptb-reservation-status .badge {
            padding: 5px 10px;
            font-weight: 500;
            font-size: 13px;
        }

        .wptb-reservation-price {
            font-weight: 600;
            color: var(--color-one);
        }

        .wptb-reservation-actions {
            margin-top: 15px;
        }

        .wptb-btn-review, .wptb-btn-cancel {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 5px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
        }

        .wptb-btn-review {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
        }

        .wptb-btn-review:hover {
            background: #ffc107;
            color: #fff;
        }

        .wptb-btn-cancel {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .wptb-btn-cancel:hover {
            background: #dc3545;
            color: #fff;
        }

        .wptb-no-reservations {
            text-align: center;
            padding: 50px 0;
            color: #777;
        }

        .rating {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .rating input {
            display: none;
        }

        .rating label {
            color: #ddd;
            font-size: 24px;
            margin: 0 5px;
            cursor: pointer;
        }

        .rating input:checked ~ label,
        .rating label:hover,
        .rating label:hover ~ label {
            color: #ffc107;
        }

        .wptb-pagination .pagination {
            justify-content: center;
            margin-top: 30px;
        }

        .wptb-pagination .page-item.active .page-link {
            background-color: var(--color-one);
            border-color: var(--color-one);
        }

        .wptb-pagination .page-link {
            color: var(--color-one);
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            let currentReservationId = null;
            let cancelUrl = null;

            // Review modal handling
            $(document).on('click', '.wptb-btn-review', function(e) {
                e.preventDefault();
                currentReservationId = $(this).data('id');
            });

            $('#submitReview').click(function() {
                const rating = $('input[name="rating"]:checked').val();
                const comment = $('#reviewComment').val();

                if (!rating) {
                    alert('Please select a rating');
                    return;
                }

                $.ajax({
                    url: '{{ path('client_reservation_review_submit') }}',
                    method: 'POST',
                    data: {
                        reservationId: currentReservationId,
                        rating: rating,
                        comment: comment
                    },
                    success: function(response) {
                        $('#reviewModal').modal('hide');
                        alert('Thank you for your review!');
                        location.reload();
                    },
                    error: function(xhr) {
                        alert('An error occurred. Please try again.');
                        console.error(xhr.responseText);
                    }
                });
            });

            // Cancel confirmation handling
            $(document).on('click', '.wptb-btn-cancel', function(e) {
                e.preventDefault();
                cancelUrl = $(this).data('href');
                $('#confirmModal').modal('show');
            });

            $('#confirmCancel').click(function() {
                if (cancelUrl) {
                    window.location.href = cancelUrl;
                }
            });

            // Reset modals when closed
            $('#reviewModal, #confirmModal').on('hidden.bs.modal', function() {
                $('input[name="rating"]').prop('checked', false);
                $('#reviewComment').val('');
                currentReservationId = null;
                cancelUrl = null;
            });
        });
    </script>
{% endblock %}