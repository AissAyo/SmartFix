{% extends 'layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .content-wrapper {
            min-height: calc(100vh - 120px);
            margin-bottom: 100px;
        }
        .footer {
            margin-top: 50px;
        }
        .page-content {
            padding: 40px 0;
        }
        .table-responsive {
            margin: 0;
        }
        .pagination {
            margin: 40px 0;
        }
        .filter-section {
            margin-bottom: 30px;
        }
        .filter-section form {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        /* Styles pour la table */
        .table {
            background-color: #ffffff;
            color: #000000;
        }
        .table th {
            background-color: #f8f9fa;
        }
        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(0, 0, 0, 0.05);
        }
        /* Styles pour les boutons de pagination */
        .page-link.text-danger:hover {
            color: #fff !important;
            background-color:var(--color-one);
            border-color: var(--color-one);
        }
        .page-link.text-danger:focus {
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }
        .page-item.active .page-link {
            background-color: var(--color-one);
            border-color: var(--color-one);
        }
        .page-link.text-danger {
            color: var(--color-one);
        }
        /* Styles pour le sélecteur de statut */
        .form-select {
            background-color: #ffffff;
            border-color: #ced4da;
            color: #000000;
        }
        .form-select:focus {
            border-color:var(--color-one);
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }
        /* Styles pour les cellules de la table */
        .table td {
            vertical-align: middle;
        }
    </style>
{% endblock %}

{% block container %}
 <main>
        <section class="pd-bottom-300">
            <div class="container">
 <div class="content-wrapper">

   
            <div class="shadow-sm rounded-lg overflow-hidden">

{# selctionner status #}

                   <div class="filter-section">
                        <div class="container-fluid p-3">
                            <form method="get" class="row g-3 align-items-center">
                                <div class="col-auto">
                                    <label class="visually-hidden" for="status">Status</label>
                                    <select class="form-select" id="status" name="status" onchange="this.form.submit()">
                                        {% for value, label in statusOptions %}
                                            <option value="{{ value }}" {% if value == selectedStatus %}selected{% endif %}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                {# <div class="col-auto">
                                    <button type="submit" class="btn btn-primary">Filtrer</button>
                                </div> #}
                            </form>
                        </div>
                    </div>





               <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Vehicle</th>
                                    <th scope="col">Service</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in reservations %}
                                <tr>
                                    <td>{{ reservation.reservationDate|date('Y-m-d H:i') }}</td>
                                    <td>{{ reservation.vehicle.plateNumber }}</td>
                                    <td>{{ reservation.service.name }}</td>
                                    <td>{{ reservation.status }}</td>
                                    <td>{{ reservation.estimatedPrice }} €</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5">No reservations found</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                
                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center p-3">
                    <span class="text-muted">
                        <span class="fw-bold text-danger">{{ pagination.getCurrentPageNumber * pagination.getItemNumberPerPage - pagination.getItemNumberPerPage + 1 }} - {{ min(pagination.getCurrentPageNumber * pagination.getItemNumberPerPage, pagination.getTotalItemCount) }}</span>
                        of
                        <span class="fw-bold text-danger">{{ pagination.getTotalItemCount }}</span>
                    </span>

                    <ul class="pagination mb-0">
                        {% if pagination.currentPageNumber != 1 %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('app_history_client', {page: pagination.currentPageNumber - 1}) }}" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                        {% endif %}

                        {% set start = max(1, pagination.currentPageNumber - 2) %}
                        {% set end = min(pagination.pageCount, pagination.currentPageNumber + 2) %}

                        {% if start > 1 %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('app_history_client', {page: 1}) }}">1</a>
                            </li>
                            {% if start > 2 %}
                                <li class="page-item disabled">
                                    <span class="page-link text-danger">...</span>
                                </li>
                            {% endif %}
                        {% endif %}

                        {% for i in start..end %}
                            <li class="page-item {% if pagination.currentPageNumber == i %}active{% endif %}">
                                <a class="page-link text-danger" href="{{ path('app_history_client', {page: i}) }}">{{ i }}</a>
                            </li>
                        {% endfor %}

                        {% if end < pagination.pageCount %}
                            {% if end < pagination.pageCount - 1 %}
                                <li class="page-item disabled">
                                    <span class="page-link text-danger">...</span>
                                </li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('app_history_client', {page: pagination.pageCount}) }}">{{ pagination.pageCount }}</a>
                            </li>
                        {% endif %}

                        {% if pagination.currentPageNumber != pagination.pageCount %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('app_history_client', {page: pagination.currentPageNumber + 1}) }}" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
     
   </div>
    </div>
        </section>
    </main>
{% endblock %}