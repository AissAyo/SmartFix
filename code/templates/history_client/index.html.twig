{% block container %}

<main>
    <div class="wptb-page-heading" style="background-image: url('{{ asset('img/background/page-header-bg.jpg') }}');">
        <div class="container">
            <div class="wptb-item--inner">
                <h2 class="wptb-item--title">My Reservation</h2>
                <div class="wptb-breadcrumb-wrap">
                    <ul class="wptb-breadcrumb">
                        <li><a href="#">Home</a></li>

                    </ul>
                </div>
            </div>
        </div>
    </div>


    <section class="pd-bottom-300">

        <div class="container">

            <div class="content-wrapper">




            <div class="shadow-sm rounded-lg overflow-hidden">

{# selctionner status #}

                   <div class="filter-section ">
                        <div class="container-fluid p-3">
                            <form method="get" class="row g-3 align-items-center">
                                <div class="col-auto">
                                    <label class="visually-hidden" for="status">Status</label>
                                    <select class="form-select" id="status" name="status" onchange="this.form.submit()">
                                        {% for value, label in statusOptions %}
                                            <option value="{{ value }}" {% if value == selectedStatus %}selected{% endif %}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                {# <div class="col-auto">
                                    <button type="submit" class="btn btn-primary">Filtrer</button>
                                </div> #}
                            </form>
                        </div>
                    </div>


                {# Reservation Cards #}
                <div class="container">
                    <div class="row">
                        {% for reservation in reservations %}
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="sidebar">
                                    <div class="wptb-project-info1 p-3 border rounded shadow-sm">
                                        <h5 class="wptb-item--title mb-3"><br>{{ reservation.vehicle.carAPI.make }} {{ reservation.vehicle.carAPI.model }} </h5>
                                        <div class="wptb--holder">
                                            <div class="wptb--item">
                                                <div class="wptb--meta"><label>Service:</label>
                                                    <span>{{ reservation.service.name }}
                                    </span>
                                                </div>
                                            </div>
                                            <div class="wptb--item">
                                                <div class="wptb--meta"><label>Garage:</label> <span>{{ reservation.service.categoryService.garage.name }}</span></div>
                                            </div>
                                            <div class="wptb--item">
                                                <div class="wptb--meta"><label>Reservation Date:</label> <span>{{ reservation.reservationDate|date('Y-m-d H:i') }}</span></div>
                                            </div>
                                            <div class="wptb--item">
                                                <div class="wptb--meta"><label>Status:</label> <span>{{ reservation.status }}</span></div>
                                            </div>
                                            <div class="wptb--item">
                                                <div class="wptb--meta"><label>Price :</label> <span>{{ reservation.estimatedPrice }} MAD</span></div>
                                            </div>
                                            {% if reservation.status|lower == 'completed' %}
                                                <div class="wptb--item mt-3">
                                                    <button class="btn btn-danger review-link" data-id="{{ reservation.id }}">Leave a Review</button>
                                                </div>
                            {% elseif reservation.status|lower == 'pending' %}
                                            <div class="d-flex justify-content-center">
                                                <a href="{{ path('client_reservation_cancel', {id: reservation.id}) }}"
                                                   class="btn btn-danger cancel-link text-white"
                                                   data-href="{{ path('client_reservation_cancel', {id: reservation.id}) }}">
                                                    <i class="bi bi-x-circle me-2"></i> cancel
                                                </a>

                                            </div>
                                             {% else %}
                                              <div class="wptb--item mt-3">
<button class="btn btn-outline-secondary" disabled></button>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <p>No reservations found.</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>



            </div>
            <!-- Overlay de confirmation - à placer en dehors de la boucle -->
<div id="customConfirm" class="overlay">
  <div class="confirm-box">
    <p>Are you sure you want to cancel this reservation?</p>
    <button class="btn btn-yes" id="confirmYes">Yes</button>
    <button class="btn btn-no" onclick="closeConfirm()">No</button>
  </div>
</div>


<div class="modal fade" id="form" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
                       <div class="text-right cross"> <i class="fa fa-times mr-2"></i> </div>
<div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>


           <div class="card-body text-center"> <img src=" https://i.imgur.com/d2dKtI7.png" height="100" width="100">
<div class="modal-body">
                <div class="comment-box text-center">
                    <h4  id="review-title">Add a comment</h4>
                    <div class="rating">
                        <input type="radio" name="rating" value="5" id="5"><label for="5">☆</label>
                        <input type="radio" name="rating" value="4" id="4"><label for="4">☆</label>
                        <input type="radio" name="rating" value="3" id="3"><label for="3">☆</label>
                        <input type="radio" name="rating" value="2" id="2"><label for="2">☆</label>
                        <input type="radio" name="rating" value="1" id="1"><label for="1">☆</label>
                    </div>
                    <div class="comment-area">
                        <textarea id="review-text" class="form-control" placeholder="Write your review here..." rows="4"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer text-center mt-4">
                <button type="button" class="btn btn-success send px-5" id="submit-review">Submit Review <i class="fa fa-long-arrow-right ml-1"></i></button>
            </div>
        </div>
    </div>
</div>

</div>

            </div>
        </div>
        <!-- Pagination -->
        <div class="wptb-pagination-wrap text-center">
            <ul class="pagination">
                {# Previous button #}
                <li>
                    <a class="page-number previous {% if pagination.currentPageNumber == 1 %}disabled{% endif %}"
                       href="{% if pagination.currentPageNumber > 1 %}{{ path('app_history_client', {page: pagination.currentPageNumber - 1, status: selectedStatus}) }}{% else %}#{% endif %}">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                {# First page #}
                {% if pagination.currentPageNumber > 3 %}
                    <li>
                        <a class="page-number" href="{{ path('app_history_client', {page: 1, status: selectedStatus}) }}">1</a>
                    </li>
                    {% if pagination.currentPageNumber > 4 %}
                        <li><span class="page-number">.....</span></li>
                    {% endif %}
                {% endif %}

                {# Page numbers around current page #}
                {% for i in max(1, pagination.currentPageNumber - 2)..min(pagination.pageCount, pagination.currentPageNumber + 2) %}
                    <li>
                        {% if pagination.currentPageNumber == i %}
                            <span class="page-number current">{{ i }}</span>
                        {% else %}
                            <a class="page-number" href="{{ path('app_history_client', {page: i, status: selectedStatus}) }}">{{ i }}</a>
                        {% endif %}
                    </li>
                {% endfor %}

                {# Last page #}
                {% if pagination.currentPageNumber < pagination.pageCount - 2 %}
                    {% if pagination.currentPageNumber < pagination.pageCount - 3 %}
                        <li><span class="page-number">.....</span></li>
                    {% endif %}
                    <li>
                        <a class="page-number" href="{{ path('app_history_client', {page: pagination.pageCount, status: selectedStatus}) }}">
                            {{ pagination.pageCount }}
                        </a>
                    </li>
                {% endif %}

                {# Next button #}
                <li>
                    <a class="page-number next {% if pagination.currentPageNumber == pagination.pageCount %}disabled{% endif %}"
                       href="{% if pagination.currentPageNumber < pagination.pageCount %}{{ path('app_history_client', {page: pagination.currentPageNumber + 1, status: selectedStatus}) }}{% else %}#{% endif %}">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>


    </section>
</main>


{% endblock %}
{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
let currentReservationId = null;
let currentCancelUrl = null;

// Initialize Bootstrap modal
const formModal = new bootstrap.Modal(document.getElementById('form'));

// Handle cancel link click
$(document).on('click', '.cancel-link', function(e) {
    e.preventDefault();
    currentCancelUrl = $(this).data('href');

    // Show confirmation overlay
    document.getElementById('customConfirm').classList.add('show');
});

// Handle confirmation buttons
document.getElementById('confirmYes').addEventListener('click', function() {
    if (currentCancelUrl) {
        window.location.href = currentCancelUrl;
    }
});

function closeConfirm() {
    document.getElementById('customConfirm').classList.remove('show');
    currentCancelUrl = null;
}

// Handle review link click
$(document).on('click', '.review-link', function(e) {
    e.preventDefault();
    currentReservationId = $(this).data('id');

    // Reset form
    $('input[name="rating"]').prop('checked', false);
    $('#review-text').val('');

    // Show modal
    formModal.show();
});

// Handle review submission
$(document).on('click', '#submit-review', function() {
    const rating = $('input[name="rating"]:checked').val();
    const comment = $('#review-text').val();

    if (!rating) {
        alert('Please select a rating');
        return;
    }

    if (!comment) {
        alert('Please write a comment');
        return;
    }

    // Send the review to the server
    $.ajax({
        url: '{{ path('client_reservation_review_submit') }}',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            reservationId: currentReservationId,
            rating: parseInt(rating),
            comment: comment
        }),
        success: function(response) {
            console.log('Success:', response);
            alert('Review submitted successfully!');
            formModal.hide();
            // Refresh the page to show the new review
            window.location.reload();
        },
        error: function(xhr, status, error) {
            try {
                const response = JSON.parse(xhr.responseText);
                console.error('Error details:', response);
                alert(`Error: ${response.error}\n\nDebug info:\n${response.debug}`);
            } catch (e) {
                console.error('Error:', error);
                alert(`Error submitting review: ${error}\n\nCheck browser console for more details`);
            }
        }
    });
});

// Close modal when clicking the close button
$(document).on('click', '.btn-close', function() {
    formModal.hide();
});

// Close confirmation overlay when clicking outside
window.onclick = function(event) {
    const overlay = document.getElementById('customConfirm');
    if (event.target == overlay && overlay.classList.contains('show')) {
        closeConfirm();
    }
}

// Close confirmation overlay when pressing ESC
window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const overlay = document.getElementById('customConfirm');
        if (overlay.classList.contains('show')) {
            closeConfirm();
        }
    }
});
</script>
{% endblock %}
