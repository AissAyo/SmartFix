{% extends 'adminNavBar.html.twig' %}
{% block stylesheet %}
    <style>
        .page-link.text-danger:hover {
            color: #fff !important;
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .page-link.text-danger:focus {
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }
        .page-item.active .page-link {
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .page-link.text-danger {
            color: #dc3545;
        }
    </style>
{% endblock %}
{% block container %}
    <section class="bg-light p-3 p-sm-5">
        <div class="container-fluid px-4 px-lg-12">
            <!-- Start coding here -->
            <div class="bg-white shadow-sm rounded-lg overflow-hidden">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4">
                    <div class="w-100 w-md-50">
                        <form class="d-flex align-items-center">
                            <label for="simple-search" class="visually-hidden">Search</label>
                            <div class="input-group w-100">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="simple-search" class="form-control" placeholder="Search" required>
                            </div>
                        </form>
                    </div>
                    <div class="w-100 w-md-auto d-flex flex-column flex-md-row align-items-stretch justify-content-end mt-2 mt-md-0">
                        <a href="{{ path('admin_cars_add') }}" class="btn btn-danger d-flex align-items-center">
                            <i class="bi bi-plus me-2"></i>
                            Add car
                        </a>


                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                        <tr>
                            <th scope="col">Brand</th>
                            <th scope="col">Model</th>

                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for car in pagination.items %}                            <tr>


                            <td>{{ car.brand}}</td>
                            <td>{{ car.model}}</td>

                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-link p-0" type="button" id="car-{{ car.id }}-dropdown-button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="car-{{ car.id }}-dropdown-button">
                                        <li>
                                            <a href="{{ path('admin_car_edit', {id: car.id}) }}" class="dropdown-item">
                                                <i class="bi bi-pencil me-2"></i>
                                                Edit
                                            </a>
                                        </li>
                                        {#                                            <li>#}
                                        {#                                                <a href="{{ path('admin_car_show', {id: car.id}) }}" class="dropdown-item">#}
                                        {#                                                    <i class="bi bi-eye me-2"></i>#}
                                        {#                                                    Preview#}
                                        {#                                                </a>#}
                                        {#                                            </li>#}
                                        <li>
                                            <form method="post" action="{{ path('admin_car_delete', {id: car.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ car.id) }}">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i>
                                                    Delete
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <nav aria-label="Table navigation" class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center p-4">
    <span class="text-muted">
        Showing
        <span class="fw-bold text-danger">{{ pagination.getCurrentPageNumber * pagination.getItemNumberPerPage - pagination.getItemNumberPerPage + 1 }} - {{ min(pagination.getCurrentPageNumber * pagination.getItemNumberPerPage, pagination.getTotalItemCount) }}</span>
        of
        <span class="fw-bold text-danger">{{ pagination.getTotalItemCount }}</span>
    </span>

                    <ul class="pagination mb-0">
                        {% if pagination.currentPageNumber != 1 %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('listclient', {page: pagination.currentPageNumber - 1}) }}" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                        {% endif %}

                        {# Show limited page numbers around current page #}
                        {% set start = max(1, pagination.currentPageNumber - 2) %}
                        {% set end = min(pagination.pageCount, pagination.currentPageNumber + 2) %}

                        {% if start > 1 %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('listclient', {page: 1}) }}">1</a>
                            </li>
                            {% if start > 2 %}
                                <li class="page-item disabled">
                                    <span class="page-link text-danger">...</span>
                                </li>
                            {% endif %}
                        {% endif %}

                        {% for page in start..end %}
                            <li class="page-item {% if page == pagination.currentPageNumber %}active{% endif %}">
                                <a class="page-link {% if page != pagination.currentPageNumber %}text-danger{% else %}text-white bg-danger border-danger{% endif %}"
                                   href="{{ path('listclient', {page: page}) }}">
                                    {{ page }}
                                </a>
                            </li>
                        {% endfor %}

                        {% if end < pagination.pageCount %}
                            {% if end < pagination.pageCount - 1 %}
                                <li class="page-item disabled">
                                    <span class="page-link text-danger">...</span>
                                </li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('listclient', {page: pagination.pageCount}) }}">
                                    {{ pagination.pageCount }}
                                </a>
                            </li>
                        {% endif %}

                        {% if pagination.currentPageNumber != pagination.pageCount %}
                            <li class="page-item">
                                <a class="page-link text-danger" href="{{ path('listclient', {page: pagination.currentPageNumber + 1}) }}" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>



            </div>
        </div>
    </section>
{% endblock %}
