{% extends 'base.html.twig' %}

{% block body %}
    <section class="bg-light p-3 p-sm-5">
        <div class="container-fluid px-4 px-lg-12">
            <!-- Start coding here -->
            <div class="bg-white shadow-sm rounded-lg overflow-hidden">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4">
                    <div class="w-100 w-md-50">
                        <form class="d-flex align-items-center">
                            <label for="simple-search" class="visually-hidden">Search</label>
                            <div class="input-group w-100">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="simple-search" class="form-control" placeholder="Search" required>
                            </div>
                        </form>
                    </div>
                    <div class="w-100 w-md-auto d-flex flex-column flex-md-row align-items-stretch justify-content-end mt-2 mt-md-0">
                        <a href="{{ path('admin_sellers_add') }}" class="btn btn-primary d-flex align-items-center">
                            <i class="bi bi-plus me-2"></i>
                            Add seller
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Logo</th>
                            <th scope="col">Working Hours</th>
                            <th scope="col">Contact Information</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for seller in sellers %}
                            <tr>
                                <th scope="row">{{ seller.name }}</th>
                                <td>{{ seller.email }}</td>
                                <td>{{ seller.phoneNumber ?? 'N/A' }}</td>
                                <td>
                                    {% if seller.logo %}
                                        <img src="{{ asset('uploads/user_uploads/' ~ seller.logo) }}"
                                             class="img-fluid rounded"
                                             style="max-width: 50px; height: auto;" alt="">
                                    {% else %}
                                        <span class="text-muted">No logo available</span>
                                    {% endif %}
                                </td>
                                <td>{{ seller.workingHours ?? 'Not specified' }}</td>
                                <td>{{ seller.contactInfo ?? 'N/A' }}</td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-link p-0" type="button" id="seller-{{ seller.id }}-dropdown-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="seller-{{ seller.id }}-dropdown-button">
                                            <li>
                                                <a href="{{ path('admin_sellers_edit', {id: seller.id}) }}" class="dropdown-item">
                                                    <i class="bi bi-pencil me-2"></i>
                                                    Edit
                                                </a>
                                            </li>
                                            <li>
                                                <a href="{{ path('admin_sellers_show', {id: seller.id}) }}" class="dropdown-item">
                                                    <i class="bi bi-eye me-2"></i>
                                                    Preview
                                                </a>
                                            </li>
                                            <li>
                                                <form method="post" action="{{ path('admin_sellers_delete', {id: seller.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ seller.id) }}">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>
                                                        Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <nav aria-label="Table navigation" class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center p-4">
                <span class="text-muted">
                    Showing
                    <span class="fw-bold">1-10</span>
                    of
                    <span class="fw-bold">1000</span>
                </span>
                    <ul class="pagination mb-0">
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item active"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">...</a></li>
                        <li class="page-item"><a class="page-link" href="#">100</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </section>
{% endblock %}