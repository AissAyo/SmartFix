{% extends 'adminNavBar.html.twig' %}

{% block container %}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="text-center">Add Seller</h1>
                <div class="mt-4">
                    {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

                    {# Name Field #}
                    <div class="form-group">
                        {{ form_label(form.name, 'Name', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Enter seller name'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    {# Email Field #}
                    <div class="form-group">
                        {{ form_label(form.email, 'Email', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter seller email'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    {# Contact Info Field #}
                    <div class="form-group">
                        {{ form_label(form.contactInfo, 'Contact Info', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.contactInfo, {'attr': {'class': 'form-control', 'placeholder': 'Enter contact information'}}) }}
                        {{ form_errors(form.contactInfo) }}
                    </div>

                    {# Password Field #}
                    <div class="form-group">
                        {{ form_label(form.password, 'Password', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Enter password'}}) }}
                        {{ form_errors(form.password) }}
                    </div>

                    {# Phone Number Field #}
                    <div class="form-group">
                        {{ form_label(form.phoneNumber, 'Phone Number', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control', 'placeholder': 'Enter phone number'}}) }}
                        {{ form_errors(form.phoneNumber) }}
                    </div>

                    {# Logo File Field #}
                    <div class="form-group">
                        {{ form_label(form.logoFile, 'Logo', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.logoFile, {'attr': {'class': 'form-control-file'}}) }}
                        {{ form_errors(form.logoFile) }}
                    </div>

                    {# Working Hours Field #}
                    <div class="form-group">
                        {{ form_label(form.workingHours, 'Working Hours', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.workingHours, {'attr': {'class': 'form-control', 'placeholder': 'Enter working hours'}}) }}
                        {{ form_errors(form.workingHours) }}
                    </div>

                    {# CSRF Token and Submit Button #}
                    <div class="form-group text-center">
                        {{ form_rest(form) }} {# Includes CSRF token #}
                        <button type="submit" class="btn btn-primary mt-3">Add Seller</button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}