{% extends 'adminNavBar.html.twig' %}

{% block title %}Edit Client{% endblock %}

{% block container %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="h4 mb-0">
                                <i class="bi bi-person-gear me-2"></i>Edit Client
                            </h2>
                            <a href="{{ path('list_clients') }}" class="btn btn-sm btn-light">
                                <i class="bi bi-arrow-left me-1"></i> Back to list
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        {# Flash messages #}
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

                        <div class="row g-3">
                            {# Name #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.name) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.name) }}
                                    </div>
                                </div>
                            </div>

                            {# Email #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.email) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>
                            </div>

                            {# Roles #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.roles, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.roles) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.roles) }}
                                    </div>
                                </div>
                            </div>

                            {# Password #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': ' ', 'autocomplete': 'new-password'}}) }}
                                    {{ form_label(form.password) }}
                                    <small class="text-muted">Leave blank to keep current password</small>
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.password) }}
                                    </div>
                                </div>
                            </div>

                            {# City #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.city, {'attr': {'class': 'form-select', 'placeholder': ' '}}) }}
                                    {{ form_label(form.city) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.city) }}
                                    </div>
                                </div>
                            </div>

                            {# Phone #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.phone) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.phone) }}
                                    </div>
                                </div>
                            </div>

                            {# Verification Status - Now as dropdown #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.verificationStatus, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.verificationStatus) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.verificationStatus) }}
                                    </div>
                                </div>
                            </div>

                            {# Profile Photo #}
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label">{{ form_label(form.ClientphotoProfilFile) }}</label>
                                    {{ form_widget(form.ClientphotoProfilFile, {'attr': {'class': 'form-control'}}) }}
                                    {% if form.vars.value.photoProfil %}
                                        <div class="mt-2">
                                            <img src="{{ asset('uploads/' ~ form.vars.value.photoProfil) }}"
                                                 alt="Current profile photo"
                                                 class="img-thumbnail"
                                                 style="max-width: 150px;">
                                            <p class="small text-muted mt-1">Current photo</p>
                                        </div>
                                    {% endif %}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.ClientphotoProfilFile) }}
                                    </div>
                                </div>
                            </div>

                            {# Form Actions #}
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-danger btn-lg px-4 me-md-2">
                                        <i class="bi bi-save me-2"></i> Save Changes
                                    </button>
                                    <a href="{{ path('list_clients') }}" class="btn btn-outline-secondary btn-lg px-4">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .card {
            border-radius: 1rem;
            overflow: hidden;
        }
        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
        }
        .img-thumbnail {
            transition: transform 0.3s ease;
        }
        .img-thumbnail:hover {
            transform: scale(1.05);
        }
    </style>
{% endblock %}