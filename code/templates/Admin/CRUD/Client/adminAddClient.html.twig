{% extends 'adminNavBar.html.twig' %}

{% block title %}Add New Client{% endblock %}

{% block container %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="h4 mb-0">
                                <i class="bi bi-person-plus me-2"></i>Add New Client
                            </h2>
                            <a href="{{ path('listclient') }}" class="btn btn-sm btn-light">
                                <i class="bi bi-arrow-left me-1"></i> Back to Clients
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        {{ form_start(form, {
                            'attr': {
                                'class': 'needs-validation',
                                'novalidate': 'novalidate',
                                'enctype': 'multipart/form-data'
                            }
                        }) }}

                        <div class="row g-3">
                            {# Name Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.name, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.name) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.name) }}
                                    </div>
                                </div>
                            </div>

                            {# Email Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.email, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.email) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>
                            </div>

                            {# Phone Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.phone, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' example 0609683488 or +212609683488'
                                        }
                                    }) }}
                                    {{ form_label(form.phone) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.phone) }}
                                    </div>
                                </div>
                            </div>

                            {# City Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.city, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.city) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.city) }}
                                    </div>
                                </div>
                            </div>

                            {# Password Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.password, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    {{ form_label(form.password) }}
                                    <small class="text-muted">Minimum 6 characters</small>
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.password) }}
                                    </div>
                                </div>
                            </div>

                            {# Verification Status #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.verificationStatus, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.verificationStatus) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.verificationStatus) }}
                                    </div>
                                </div>
                            </div>

                            {# Roles Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.roles, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.roles) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.roles) }}
                                    </div>
                                </div>
                            </div>

                            {# Profile Photo #}
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label">{{ form_label(form.ClientphotoProfilFile) }}</label>
                                    {{ form_widget(form.ClientphotoProfilFile, {
                                        'attr': {
                                            'class': 'form-control'
                                        }
                                    }) }}
                                    <small class="text-muted">JPEG, PNG or GIF (Max 2MB)</small>
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.ClientphotoProfilFile) }}
                                    </div>
                                </div>
                            </div>

                            {# Form Actions #}
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-danger btn-lg px-4 me-md-2">
                                        <i class="bi bi-save me-2"></i> Add Client
                                    </button>
                                    <a href="{{ path('listclient') }}" class="btn btn-outline-secondary btn-lg px-4">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .card {
            border-radius: 1rem;
            overflow: hidden;
        }
        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
        }
        .img-thumbnail {
            transition: transform 0.3s ease;
        }
        .img-thumbnail:hover {
            transform: scale(1.05);
        }
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .form-floating>label {
            padding: 0.5rem 0.75rem;
        }
    </style>
{% endblock %}