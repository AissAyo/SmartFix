<form method="post" action="{{ path('admin_clients_delete', {'id': client.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <!-- CSRF Token for security -->
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">

    <!-- Delete Button -->
    <button class="btn btn-danger">Delete</button>
</form>
