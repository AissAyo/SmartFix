{% extends 'adminNavBar.html.twig' %}

{% block title %}Add New Service{% endblock %}

{% block container %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="h4 mb-0">
                                <i class="bi bi-tools me-2"></i>Add New Service
                            </h2>
                            <a href="{{ path('service_index') }}" class="btn btn-sm btn-light">
                                <i class="bi bi-arrow-left me-1"></i> Back to Services
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        {{ form_start(form, {
                            'attr': {
                                'class': 'needs-validation',
                                'novalidate': 'novalidate',
                                'enctype': 'multipart/form-data'
                            }
                        }) }}

                        <div class="row g-3">
                            {# Service Name Field #}
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.serviceName, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Service Name',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.serviceName, 'Service Name') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.serviceName) }}
                                    </div>
                                </div>
                            </div>

                            {# Description Field #}
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.description, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Description',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.description, 'Description') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.description) }}
                                    </div>
                                </div>
                            </div>

                            {# Category Service Field #}
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.categoryService, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': 'Category'
                                        }
                                    }) }}
                                    {{ form_label(form.categoryService, 'Category') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.categoryService) }}
                                    </div>
                                </div>
                            </div>

                            {# Form Actions #}
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-danger btn-lg px-4 me-md-2">
                                        <i class="bi bi-save me-2"></i> Create Service
                                    </button>
                                    <a href="{{ path('service_index') }}" class="btn btn-outline-secondary btn-lg px-4">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .card {
            border-radius: 1rem;
            overflow: hidden;
        }
        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
        }
        .img-thumbnail {
            transition: transform 0.3s ease;
        }
        .img-thumbnail:hover {
            transform: scale(1.05);
        }
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .form-floating>label {
            padding: 0.5rem 0.75rem;
        }
    </style>
{% endblock %}