{% extends 'adminNavBar.html.twig' %}

{% block stylesheet %}
    <style>
        .page-link.text-danger:hover {
            color: #fff !important;
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .page-link.text-danger:focus {
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }
        .page-item.active .page-link {
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .page-link.text-danger {
            color: #dc3545;
        }
        .badge-active {
            background-color: #28a745;
        }
        .badge-inactive {
            background-color: #6c757d;
        }
    </style>
{% endblock %}

{% block container %}
    <section class="bg-light p-3 p-sm-5">
        <div class="container-fluid px-4 px-lg-12">
            <!-- Start coding here -->
            <div class="bg-white shadow-sm rounded-lg overflow-hidden">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4">
                    <div class="w-100 w-md-50">
                        <form class="d-flex align-items-center">
                            <label for="service-search" class="visually-hidden">Search</label>
                            <div class="input-group w-100">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="service-search" class="form-control" placeholder="Search services..." required>
                            </div>
                        </form>
                    </div>
                    <div class="w-100 w-md-auto d-flex flex-column flex-md-row align-items-stretch justify-content-end mt-2 mt-md-0">
                        <a href="{{ path('service_new') }}" class="btn btn-danger d-flex align-items-center">
                            <i class="bi bi-plus me-2"></i>
                            Add Service
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col"> Description</th>
                            <th scope="col">Category</th>

                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for service in services %}
                            <tr>
                                <th scope="row">{{ service.id }}</th>
                                <td>{{ service.serviceName }}</td>
                                <td>{{ service.description }}</td>
                                <td>{{ service.categoryService.Categoryname }}</td>

                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-link p-0" type="button" id="service-{{ service.id }}-dropdown-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="service-{{ service.id }}-dropdown-button">
                                            <li>
                                                <a href="{{ path('service_show', {'id': service.id}) }}" class="dropdown-item">
                                                    <i class="bi bi-eye me-2"></i>
                                                    View
                                                </a>
                                            </li>
                                            <li>
                                                <a href="{{ path('service_edit', {'id': service.id}) }}" class="dropdown-item">
                                                    <i class="bi bi-pencil me-2"></i>
                                                    Edit
                                                </a>
                                            </li>
                                            <li>
                                                <form method="post" action="{{ path('service_delete', {'id': service.id}) }}" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>
                                                        Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4">No services found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination would go here if you implement it #}
                {# You can add the same pagination structure as in the example when needed #}

            </div>
        </div>
    </section>
{% endblock %}