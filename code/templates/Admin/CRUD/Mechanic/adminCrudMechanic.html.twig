    {% extends 'adminNavBar.html.twig' %}

    {% block stylesheet %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
        <style>

            .page-link.text-danger:hover {
                color: #fff !important;
                background-color: #dc3545;
                border-color: #dc3545;
            }
            .page-link.text-danger:focus {
                box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
            }
            .page-item.active .page-link {
                background-color: #dc3545;
                border-color: #dc3545;
            }
            .page-link.text-danger {
                color: #dc3545;
            }
        </style>
    {% endblock %}
    {% block container %}
        <section class="bg-light p-3 p-sm-5">
            <div class="container-fluid px-4 px-lg-12">
                <div class="bg-white shadow-sm rounded-lg overflow-hidden">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4">
                        <div class="w-100 w-md-50">
                            <form class="d-flex align-items-center">
                                <label for="simple-search" class="visually-hidden">Search</label>
                                <div class="input-group w-100">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" id="simple-search" class="form-control" placeholder="Search mechanics" required>
                                </div>
                            </form>
                        </div>
                        <div class="w-100 w-md-auto d-flex flex-column flex-md-row align-items-stretch justify-content-end mt-2 mt-md-0">
                            <a href="{{ path('admin_mechanics_add') }}" class="btn btn-danger d-flex align-items-center">
                                <i class="bi bi-plus me-2"></i>
                                Add Mechanic
                            </a>
                        </div>
                    </div>

                    <!-- Start Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th scope="col">Photo Profil</th>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Phone</th>
                                <th scope="col">City</th>
                                <th scope="col">Adress</th>
                                <th scope="col">Role</th>
                                <th scope="col">Password</th>
                                <th scope="col">Specialization</th>
                                <th scope="col">Experience</th>
                                <th scope="col">Certifications</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for mechanic in pagination.items %}                            <tr>
                                <tr>
                                    <th scope="row">
                                        {% if mechanic.photoProfil %}
                                            <img src="{{ asset('uploads/' ~ mechanic.photoProfil) }}" alt="Mechanic Logo"style="width: 50px;  /* Adjust size */
        height: 50px;  /* Ensure the height and width are the same to make it a circle */
        border-radius: 50%;  /* Makes the image circular */
        object-fit: cover;  /* Ensures the image covers the area without distorting */
        border: 2px solid #ddd;">
                                        {% else %}
                                            <p>No logo uploaded.</p>
                                        {% endif %}
                                    </th>

                                    <td>{{ mechanic.name }}</td>
                                    <td>{{ mechanic.email }}</td>
                                    <td>{{ mechanic.phone ?? 'N/A' }}</td>
                                    <td>{{ mechanic.city }}</td>
                                    <td>{{ mechanic.address }}</td>
                                    <td>{{ mechanic.roles}}</td>
                                    <td>{{ mechanic.password}}</td>
                                    <td>{{ mechanic.specialization ?? 'General' }}</td>
                                    <td>{{ mechanic.experienceYears ?? '0' }} years</td>
                                    <td>
                                        {% if mechanic.certifications %}
                                            <ul>
                                                {% for cert in mechanic.certifications %}
                                                    <li>{{ cert }}</li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                            <p class="text-muted">No certifications</p>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-link p-0" type="button" id="mechanic-{{ mechanic.id }}-dropdown-button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="mechanic-{{ mechanic.id }}-dropdown-button">
                                                <li>
                                                    <a href="{{ path('admin_mechanics_edit', {id: mechanic.id}) }}" class="dropdown-item">
                                                        <i class="bi bi-pencil me-2"></i>
                                                        Edit
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="{{ path('admin_mechanics_show', {id: mechanic.id}) }}" class="dropdown-item">
                                                        <i class="bi bi-eye me-2"></i>
                                                        View Details
                                                    </a>
                                                </li>
                                                <li>
                                                    <form method="post" action="{{ path('admin_mechanics_delete', {id: mechanic.id}) }}" onsubmit="return confirm('Are you sure you want to delete this mechanic?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mechanic.id) }}">
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash me-2"></i>
                                                            Delete
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <!-- End Table -->

                    <nav aria-label="Table navigation" class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center p-4">
        <span class="text-muted">
            Showing
            <span class="fw-bold text-danger">{{ pagination.getCurrentPageNumber * pagination.getItemNumberPerPage - pagination.getItemNumberPerPage + 1 }} - {{ min(pagination.getCurrentPageNumber * pagination.getItemNumberPerPage, pagination.getTotalItemCount) }}</span>
            of
            <span class="fw-bold text-danger">{{ pagination.getTotalItemCount }}</span>
        </span>

                        <ul class="pagination mb-0">
                            {% if pagination.currentPageNumber != 1 %}
                                <li class="page-item">
                                    <a class="page-link text-danger" href="{{ path('admin_list_mechanic', {page: pagination.currentPageNumber - 1}) }}" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            {% endif %}

                            {% set start = max(1, pagination.currentPageNumber - 2) %}
                            {% set end = min(pagination.pageCount, pagination.currentPageNumber + 2) %}

                            {% if start > 1 %}
                                <li class="page-item">
                                    <a class="page-link text-danger" href="{{ path('admin_list_mechanic', {page: 1}) }}">1</a>
                                </li>
                                {% if start > 2 %}
                                    <li class="page-item disabled">
                                        <span class="page-link text-danger">...</span>
                                    </li>
                                {% endif %}
                            {% endif %}

                            {% for page in start..end %}
                                <li class="page-item {% if page == pagination.currentPageNumber %}active{% endif %}">
                                    <a class="page-link {% if page != pagination.currentPageNumber %}text-danger{% else %}text-white bg-danger border-danger{% endif %}"
                                       href="{{ path('admin_list_mechanic', {page: page}) }}">
                                        {{ page }}
                                    </a>
                                </li>
                            {% endfor %}

                            {% if end < pagination.pageCount %}
                                {% if end < pagination.pageCount - 1 %}
                                    <li class="page-item disabled">
                                        <span class="page-link text-danger">...</span>
                                    </li>
                                {% endif %}
                                <li class="page-item">
                                    <a class="page-link text-danger" href="{{ path('admin_list_mechanic', {page: pagination.pageCount}) }}">
                                        {{ pagination.pageCount }}
                                    </a>
                                </li>
                            {% endif %}

                            {% if pagination.currentPageNumber != pagination.pageCount %}
                                <li class="page-item">
                                    <a class="page-link text-danger" href="{{ path('admin_list_mechanic', {page: pagination.currentPageNumber + 1}) }}" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>


                </div>
            </div>
        </section>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    {% endblock %}
