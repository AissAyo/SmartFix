{% extends 'adminNavBar.html.twig' %}

{% block container %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-danger text-white">
                        <h2 class="h4 mb-0 text-center"><i class="fas fa-user-cog me-2"></i>Add New Mechanic</h2>
                    </div>

                    <div class="card-body p-4">
                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

                        <div class="row g-3">
                            {# Personal Information Section #}
                            <div class="col-md-6">
                                <h5 class="text-danger mb-4"><i class="fas fa-id-card me-2"></i>Personal Information</h5>

                                <div class="form-floating mb-3">
                                    {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.name, 'Full Name') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.name) }}
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.email, 'Email Address') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>



                                <div class="form-floating mb-3">
                                    {{ form_widget(form.address, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.address, 'Address') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.address) }}
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    {{ form_widget(form.city, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.city, 'City') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.city) }}
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.password, 'Password') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.password) }}
                                    </div>
                                </div>
                            </div>

                            {# Professional Information Section #}
                            <div class="col-md-6">
                                <h5 class="text-danger mb-4"><i class="fas fa-tools me-2"></i>Professional Details</h5>

                                <div class="form-floating mb-3">
                                    {{ form_widget(form.specialization, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.specialization, 'Specialization') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.specialization) }}
                                    </div>
                                </div>

                                <div class="form-floating mb-3">
                                    {{ form_widget(form.experienceYears, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                    {{ form_label(form.experienceYears, 'Experience (Years)') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.experienceYears) }}
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.certifications, 'Certifications', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.certifications, {'attr': {
                                        'class': 'form-control',
                                        'rows': 3,
                                        'placeholder': 'ASE Certification\nElectrical Systems Certification\n...'
                                    }}) }}
                                    <small class="text-muted">One certification per line</small>
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.certifications) }}
                                    </div>
                                </div>

                                {# File Uploads Section #}
                                <h5 class="text-danger mt-4 mb-3"><i class="fas fa-images me-2"></i>Images</h5>

                                <div class="mb-3">
                                    <div class="file-upload-card p-3 border rounded">
                                        {{ form_label(form.logoFile, 'Garage Logo', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.logoFile, {'attr': {'class': 'form-control'}}) }}
                                        <small class="text-muted">PNG/JPG, max 2MB</small>
                                        <div class="invalid-feedback">
                                            {{ form_errors(form.logoFile) }}
                                        </div>
                                    </div>
                                </div>

                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <button type="submit" class="btn btn-do btn-lg px-4">
                                <i class="fas fa-save me-2"></i>Save Mechanic
                            </button>
                            <a href="{{ path('admin_list_mechanic') }}" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .file-upload-card {
            background-color: #f8f9fa;
            transition: all 0.3s ease;
        }
        .file-upload-card:hover {
            background-color: #e9ecef;
        }
        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .card {
            border-radius: 15px;
            overflow: hidden;
        }
        .card-header {
            border-radius: 15px 15px 0 0 !important;
        }
    </style>
{% endblock %}