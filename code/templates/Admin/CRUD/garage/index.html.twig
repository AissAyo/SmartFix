{% extends 'adminNavBar.html.twig' %}

{% block stylesheet %}
    <style>
        .page-link.text-danger:hover {
            color: #fff !important;
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .page-link.text-danger:focus {
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }
        .page-item.active .page-link {
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .page-link.text-danger {
            color: #dc3545;
        }
    </style>
{% endblock %}

{% block container %}
    <h1>Garages</h1>
    <section class="bg-light p-3 p-sm-5">
        <div class="container-fluid px-4 px-lg-12">
            <!-- Start coding here -->
            <div class="bg-white shadow-sm rounded-lg overflow-hidden">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4">
                    <div class="w-100 w-md-50">
                        <form class="d-flex align-items-center">
                            <label for="simple-search" class="visually-hidden">Search</label>
                            <div class="input-group w-100">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="simple-search" class="form-control" placeholder="Search garages..." required>
                            </div>
                        </form>
                    </div>
                    <div class="w-100 w-md-auto d-flex flex-column flex-md-row align-items-stretch justify-content-end mt-2 mt-md-0">
                        <a href="{{ path('garage_new') }}" class="btn btn-danger d-flex align-items-center">
                            <i class="bi bi-plus me-2"></i>
                            Add Garage
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Rating</th>
                            <th scope="col">Location</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for garage in garages %}
                            <tr>
                                <th scope="row">{{ garage.name }}</th>
                                <td>{{ garage.emailGarage }}</td>
                                <td>
                                    <span class="badge bg-{{ garage.status == 'Active' ? 'success' : 'secondary' }}">
                                        {{ garage.status }}
                                    </span>
                                </td>
                                <td>
                                    <div class="text-warning">
                                        {% for i in 1..5 %}
                                            <i class="bi bi-star{{ i <= garage.rating ? '-fill' : '' }}"></i>
                                        {% endfor %}
                                    </div>
                                </td>
                                <td>{{ garage.location.address }}</td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-link p-0" type="button" id="garage-{{ garage.id }}-dropdown-button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="garage-{{ garage.id }}-dropdown-button">
                                            <li>
                                                <a href="{{ path('garage_show', {id: garage.id}) }}" class="dropdown-item">
                                                    <i class="bi bi-eye me-2"></i>
                                                    View
                                                </a>
                                            </li>
                                            <li>
                                                <a href="{{ path('garage_edit', {id: garage.id}) }}" class="dropdown-item">
                                                    <i class="bi bi-pencil me-2"></i>
                                                    Edit
                                                </a>
                                            </li>
                                            <li>
                                                <form method="post" action="{{ path('garage_delete', {id: garage.id}) }}" onsubmit="return confirm('Are you sure you want to delete this garage?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ garage.id) }}">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>
                                                        Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4">No garages found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination would go here if you implement it #}
                {# You can add the same pagination structure as in the example when needed #}

            </div>
        </div>
    </section>
{% endblock %}