{% extends 'adminNavBar.html.twig' %}

{% block title %}Edit Garage{% endblock %}

{% block container %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="h4 mb-0">
                                <i class="bi bi-house-gear me-2"></i>Edit Garage
                            </h2>
                            <a href="{{ path('garage_index') }}" class="btn btn-sm btn-light">
                                <i class="bi bi-arrow-left me-1"></i> Back to Garages
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        {# Flash messages #}
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        {{ form_start(form, {
                            'attr': {
                                'class': 'needs-validation',
                                'novalidate': 'novalidate'
                            }
                        }) }}

                        <div class="row g-3">
                            {# Name Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.name, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.name) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.name) }}
                                    </div>
                                </div>
                            </div>

                            {# Email Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.emailGarage, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.emailGarage) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.emailGarage) }}
                                    </div>
                                </div>
                            </div>

                            {# City Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.City, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.City) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.City) }}
                                    </div>
                                </div>
                            </div>

                            {# Rating Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.rating, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.rating) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.rating) }}
                                    </div>
                                </div>
                            </div>

                            {# Status Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.status, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.status) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.status) }}
                                    </div>
                                </div>
                            </div>

                            {# Working Hours Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.workingHours, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.workingHours) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.workingHours) }}
                                    </div>
                                </div>
                            </div>

                            {# Mechanic Field #}
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.mechanic, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.mechanic) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.mechanic) }}
                                    </div>
                                </div>
                            </div>

                            {# Location Section Header #}
                            <div class="col-12 mt-4">
                                <h5 class="mb-3 border-bottom pb-2">
                                    <i class="bi bi-geo-alt me-2"></i>Location Information
                                </h5>
                            </div>

                            {# Location Fields #}
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.location.address, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.location.address) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.location.address) }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.location.latitude, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.location.latitude) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.location.latitude) }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.location.longitude, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.location.longitude) }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.location.longitude) }}
                                    </div>
                                </div>
                            </div>

                            {# Form Actions #}
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-danger btn-lg px-4 me-md-2">
                                        <i class="bi bi-save me-2"></i> Save Changes
                                    </button>
                                    <a href="{{ path('garage_index') }}" class="btn btn-outline-secondary btn-lg px-4">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .card {
            border-radius: 1rem;
            overflow: hidden;
        }
        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
        }
        .form-floating > label {
            color: #6c757d;
        }
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label,
        .form-floating > .form-select ~ label {
            color: #dc3545;
        }
        .text-muted {
            font-size: 0.875rem;
        }
    </style>
{% endblock %}