{% extends 'adminNavBar.html.twig' %}

{% block title %}Edit Reservation{% endblock %}

{% block container %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="h4 mb-0">
                                <i class="bi bi-tools me-2"></i>Edit Reservation
                            </h2>
                            <a href="{{ path('reservation_index') }}" class="btn btn-sm btn-light">
                                <i class="bi bi-arrow-left me-1"></i> Back to Reservations
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        {{ form_start(form, {
                            'attr': {
                                'class': 'needs-validation',
                                'novalidate': 'novalidate',
                                'enctype': 'multipart/form-data'
                            }
                        }) }}

                        <div class="row g-3">
                            {# Reservation Date Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.reservationDate, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.reservationDate, 'Reservation Date') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.reservationDate) }}
                                    </div>
                                </div>
                            </div>

                            {# Status Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.status, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.status, 'Status') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.status) }}
                                    </div>
                                </div>
                            </div>

                            {# Notes Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.notes, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': ' ',
                                            'required': 'required'
                                        }
                                    }) }}
                                    {{ form_label(form.notes, 'Notes') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.notes) }}
                                    </div>
                                </div>
                            </div>

                            {# Vehicle Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.vehicle, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.vehicle, 'Vehicle') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.vehicle) }}
                                    </div>
                                </div>
                            </div>

                            {# Client Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.client, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.client, 'Client') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.client) }}
                                    </div>
                                </div>
                            </div>

                            {# Garage Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.garage, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.garage, 'Garage') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.garage) }}
                                    </div>
                                </div>
                            </div>

                            {# Services Field #}
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    {{ form_widget(form.services, {
                                        'attr': {
                                            'class': 'form-select',
                                            'placeholder': ' '
                                        }
                                    }) }}
                                    {{ form_label(form.services, 'Services') }}
                                    <div class="invalid-feedback">
                                        {{ form_errors(form.services) }}
                                    </div>
                                </div>
                            </div>

                            {# Form Actions #}
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-danger btn-lg px-4 me-md-2">
                                        <i class="bi bi-save me-2"></i> Save Changes
                                    </button>
                                    <a href="{{ path('reservation_index') }}" class="btn btn-outline-secondary btn-lg px-4">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .card {
            border-radius: 1rem;
            overflow: hidden;
        }
        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
        }
        .img-thumbnail {
            transition: transform 0.3s ease;
        }
        .img-thumbnail:hover {
            transform: scale(1.05);
        }
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .form-floating>label {
            padding: 0.5rem 0.75rem;
        }
    </style>
{% endblock %}