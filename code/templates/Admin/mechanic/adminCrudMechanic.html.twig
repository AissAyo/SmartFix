{% extends 'base.html.twig' %}

{% block body %}
<section class="bg-light p-3 p-sm-5">
    <div class="container-fluid px-4 px-lg-12">
        <!-- Start coding here -->
        <div class="bg-white shadow-sm rounded-lg overflow-hidden">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4">
                <div class="w-100 w-md-50">
                    <form class="d-flex align-items-center">
                        <label for="simple-search" class="visually-hidden">Search</label>
                        <div class="input-group w-100">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="simple-search" class="form-control" placeholder="Search" required>
                        </div>
                    </form>
                </div>
                <div class="w-100 w-md-auto d-flex flex-column flex-md-row align-items-stretch justify-content-end mt-2 mt-md-0">
                    <a href="{{ path('admin_mechanics_new') }}" class="btn btn-primary d-flex align-items-center">
                        <i class="bi bi-plus me-2"></i>
                        Add Mechanic
                    </a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">password</th>
                            <th scope="col">Address</th>
                            <th scope="col">City</th>
                            <th scope="col">roles</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for mechanic in mechanics %}
                        <tr>
                            <th scope="row">{{ mechanic.name }}</th>
                            <td>{{ mechanic.email }}</td>
                            <td>{{ mechanic.email }}</td>
                            <td>{{ mechanic.password }} years</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-link p-0" type="button" id="mechanic-{{ mechanic.id }}-dropdown-button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="mechanic-{{ mechanic.id }}-dropdown-button">
                                        <li>
                                            <a href="{{ path('admin_mechanics_edit', {id: mechanic.id}) }}" class="dropdown-item">
                                                <i class="bi bi-pencil me-2"></i>
                                                Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{ path('admin_mechanics_show', {id: mechanic.id}) }}" class="dropdown-item">
                                                <i class="bi bi-eye me-2"></i>
                                                Preview
                                            </a>
                                        </li>
                                        <li>
                                            <form method="post" action="{{ path('admin_mechanics_delete', {id: mechanic.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mechanic.id) }}">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i>
                                                    Delete
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <nav aria-label="Table navigation" class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center p-4">
                <span class="text-muted">
                    Showing
                    <span class="fw-bold">1-10</span>
                    of
                    <span class="fw-bold">1000</span>
                </span>
                <ul class="pagination mb-0">
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item active"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">...</a></li>
                    <li class="page-item"><a class="page-link" href="#">100</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</section>
{% endblock %}