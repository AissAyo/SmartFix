{% extends 'adminNavBar.html.twig' %}

{% block stylesheets %}
{{ parent() }}
    <style>
        .chart-container {
            position: relative;
            width: 80%; /* Set the width to 80% of its parent container */
            max-width: 600px; /* Set a max-width so the chart doesn't grow too large */
            height: 300px;  /* Set a fixed height */
            margin: auto;  /* Center the chart within its container */
        }

        canvas {
            width: 100% !important; /* Make canvas take 100% of the container width */
            height: 100% !important; /* Make canvas take 100% of the container height */
        }
        .count-chart-container{
            margin-top: 2%;
        }
    </style>
{% endblock %}

{% block container %}
  <div class="count-chart-container">

      {{ render(controller("App\\Controller\\AdminController\\Stats\\MechanicDashboardController::mechaniccountpercity")) }}
      {{ render(controller("App\\Controller\\AdminController\\Stats\\MechanicDashboardController::dashboard")) }}
      {{ render(controller("App\\Controller\\AdminController\\Stats\\GarageChartController::garageChartpercity")) }}
  </div>




    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

{% endblock %}