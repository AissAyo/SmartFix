{% block stylesheet %}
    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #3f37c9;
            --secondary: #3a0ca3;
            --success: #4cc9f0;
            --danger: #f72585;
            --warning: #f8961e;
            --info: #4895ef;
            --light: #f8f9fa;
            --dark: #212529;
            --gray: #6c757d;
            --light-gray: #e9ecef;
        }

        .stats-container-mechanic {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .stat-card-mechanic {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border-left: 4px solid var(--primary);
        }

        .stat-card-mechanic-content {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .stat-card-mechanic-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(67, 97, 238, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 1.5rem;
        }

        .stat-card-mechanic-text {
            flex: 2;
        }

        .stat-card-mechanic-label {
            color: var(--gray);
            margin: 0 0 0.5rem 0;
            font-size: 0.9rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        .chart-container-mechanic {
            position: relative;
            width: 100%;
            height: 250px;
        }

        .no-data-mechanic {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--gray);
        }

        @media (max-width: 768px) {
            .stat-card-mechanic-content {
                flex-direction: column;
            }

            .chart-container-mechanic {
                height: 200px;
            }
        }
    </style>
{% endblock  %}

{% block container %}
    <div class="stats-container-mechanic">
        <!-- Garages by Mechanic Chart Card -->
        <div class="stat-card-mechanic chart-card">
            <div class="stat-card-mechanic-content">
                <div class="stat-card-mechanic-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <div class="stat-card-mechanic-text">
                    <p class="stat-card-mechanic-label">Garages by Mechanic</p>
                    <div class="chart-container-mechanic">
                        {% if chart is not null %}
                            <canvas id="mechanicChart"></canvas>
                        {% else %}
                            <div class="no-data-mechanic">No mechanic distribution data available</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
    var ctx = document.getElementById('mechanicChart').getContext('2d');
    var mechanicChart = new Chart(ctx, {
    type: 'bar',
    data: {
    labels: {{ chart.data.labels|json_encode|raw }},
                datasets: [{
                    label: 'Garages',
                    data: {{ chart.data.datasets[0].data|json_encode|raw }},
                    backgroundColor: 'rgba(67, 97, 238, 0.7)',
                    borderColor: 'rgba(255, 255, 255, 0.8)',
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            drawBorder: false,
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    });
</script>
{% endblock %}
