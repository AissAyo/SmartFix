{% block container %}
    <div class="stats-container-cyrcle">
    <!-- Client Status Chart Card -->
    <div class="stat-card-cyrcle chart-card">
        <div class="stat-card-cyrcle-content">
            <div class="stat-card-cyrcle-icon">
                <i class="fas fa-chart-pie"></i>
            </div>
            <div class="stat-card-cyrcle-text">
                <p class="stat-card-cyrcle-label">Client Status Distribution</p>
                <div class="chart-container-cyrcle">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
        <div class="stat-card-cyrcle-footer">
            <small class="text-muted">Last updated: <span class="update-time">{{ "now"|date("Y-m-d H:i:s") }}</span></small>
        </div>
    </div>

    <!-- Additional Mini Stats -->


    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #3f37c9;
            --secondary: #3a0ca3;
            --success: #4cc9f0;
            --danger: #f72585;
            --warning: #f8961e;
            --info: #4895ef;
            --light: #f8f9fa;
            --dark: #212529;
            --gray: #6c757d;
            --light-gray: #e9ecef;
        }

        .stats-container-cyrcle {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        /* Stat Card Styles */
        .stat-card-cyrcle {
            background: white;
            border-radius: 12px;
            padding: 1.75rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border-left: 4px solid var(--primary);
            display: flex;
            flex-direction: column;
        }

        .stat-card-cyrcle.chart-card {
            padding: 1.5rem;
        }

        .stat-card-cyrcle-content {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex: 1;
        }

        .stat-card-cyrcle-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(67, 97, 238, 0.1) 0%, rgba(67, 97, 238, 0.2) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 2rem;
            flex-shrink: 0;
        }

        .chart-card .stat-card-cyrcle-icon {
            background: linear-gradient(135deg, rgba(247, 37, 133, 0.1) 0%, rgba(247, 37, 133, 0.2) 100%);
            color: var(--danger);
        }

        .stat-card-cyrcle-text {
            flex: 1;
        }

        .stat-card-cyrcle-label {
            color: var(--gray);
            margin: 0 0 1rem 0;
            font-size: 1rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .chart-container-cyrcle {
            position: relative;
            width: 100%;
            height: 200px;
            margin-top: 1rem;
        }

        .stat-card-cyrcle-footer {
            margin-top: 1rem;
            padding-top: 0.75rem;
            border-top: 1px solid var(--light-gray);
            font-size: 0.75rem;
            color: var(--gray);
        }



        .stat-card-cyrcle {
            animation: fadeIn 0.5s ease forwards;
        }


        /* Responsive Design */
        @media (max-width: 768px) {
            .mini-stats-grid {
                grid-template-columns: 1fr;
            }

            .stat-card-cyrcle-content {
                flex-direction: column;
                text-align: center;
            }

            .chart-container-cyrcle {
                height: 250px;
            }
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <script>
        // Initialize chart
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('statusChart').getContext('2d');
            const statusChart = new Chart(ctx, {
                type: '{{ chartc.type }}',
                data: {
                    labels: {{ chartc.data.labels|json_encode|raw }},
                    datasets: [{
                        data: {{ chartc.data.datasets[0].data|json_encode|raw }},
                        backgroundColor: {{ chartc.data.datasets[0].backgroundColor|json_encode|raw }},
                        borderColor: '#fff',
                        borderWidth: 2,
                        hoverBorderWidth: 3,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 12,
                                padding: 20,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                font: {
                                    weight: 500
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.85)',
                            titleFont: {
                                weight: 'bold',
                                size: 14
                            },
                            bodyFont: {
                                size: 12
                            },
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((context.raw / total) * 100);
                                    return `${context.label}: ${context.raw} (${percentage}%)`;
                                }
                            }
                        },
                        datalabels: {
                            color: '#fff',
                            font: {
                                weight: 'bold',
                                size: 12
                            },
                            formatter: (value, ctx) => {
                                const total = ctx.chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                                return Math.round((value / total) * 100) + '%';
                            }
                        }
                    },
                    animation: {
                        animateScale: true,
                        animateRotate: true
                    }
                },
                plugins: [ChartDataLabels]
            });
        });
    </script>
{% endblock %}