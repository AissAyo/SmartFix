
    {% block stylesheet %}
        <style>
            :root {
                --primary: #4361ee;
                --primary-light: #3f37c9;
                --secondary: #3a0ca3;
                --success: #4cc9f0;
                --danger: #f72585;
                --warning: #f8961e;
                --info: #4895ef;
                --light: #f8f9fa;
                --dark: #212529;
                --gray: #6c757d;
                --light-gray: #e9ecef;
            }

            .stats-container-city {
                max-width: 1200px;
                margin: 2rem auto;
                padding: 0 1rem;
            }

            .stat-card-city {
                background: white;
                border-radius: 12px;
                padding: 1.5rem;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
                border-left: 4px solid var(--primary);
            }

            .stat-card-city-content {
                display: flex;
                align-items: center;
                gap: 1.5rem;
            }

            .stat-card-city-icon {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: rgba(67, 97, 238, 0.1);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--primary);
                font-size: 1.5rem;
            }

            .stat-card-city-text {
                flex: 2;
            }

            .stat-card-city-label {
                color: var(--gray);
                margin: 0 0 0.5rem 0;
                font-size: 0.9rem;
                font-weight: 500;
                text-transform: uppercase;
            }

            .chart-container-city {
                position: relative;
                width: 100%;
                height: 250px;
            }

            .no-data-city{
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100%;
                color: var(--gray);
            }



            @media (max-width: 768px) {
                .stat-card-city-content {
                    flex-direction: column;
                }

                .chart-container-city {
                    height: 200px;
                }
            }
        </style>
    {% endblock  %}
{% block container %}
    <div class="stats-container-city">
        <!-- Clients by City Chart Card -->
        <div class="stat-card-city chart-card">
            <div class="stat-card-city-content">
                <div class="stat-card-city-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="stat-card-city-text">
                    <p class="stat-card-city-label">Clients by City</p>
                    <div class="chart-container-city">
                        {% if chart is not null %}
                            <canvas id="cityChart"></canvas>
                        {% else %}
                            <div class="no-data-city-city">No city distribution data available</div>
                        {% endif %}
                    </div>
                </div>
            </div>

        </div>
    </div>




{% endblock%}

{% block javascript %}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {

var ctx = document.getElementById('cityChart').getContext('2d');
var cityChart = new Chart(ctx, {
    type: 'bar',
    data: {
        labels: {{ chart.data.labels|json_encode|raw }},
        datasets: [{
            label: 'Clients',
            data: {{ chart.data.datasets[0].data|json_encode|raw }},
            backgroundColor: 'rgba(67, 97, 238, 0.7)',
            borderColor: 'rgba(255, 255, 255, 0.8)',
            borderWidth: 2,
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                grid: {
                    drawBorder: false,
                    color: 'rgba(0, 0, 0, 0.05)'
                }
            },
            x: {
                grid: {
                    display: false
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});
});
</script>
{% endblock %}

