{% extends 'adminNavBar.html.twig' %}
{% block stylesheet %}
    {% block stylesheets %}
        {{ parent( ) }}
        <style>
            .chart-container {
                position: relative;
                width: 80%; /* Set the width to 80% of its parent container */
                max-width: 600px; /* Set a max-width so the chart doesn't grow too large */
                height: 300px;  /* Set a fixed height */
                margin: auto;  /* Center the chart within its container */
            }

            canvas {
                width: 100% !important; /* Make canvas take 100% of the container width */
                height: 100% !important; /* Make canvas take 100% of the container height */
            }
        </style>
    {% endblock %}
    </style>
{% endblock %}
{% block container %}
    <br>
    <br>
    {#    <h1>Sellers by City</h1>#}

    {#    {% if chart is not null %}#}

    {#        <div class="chart-container">#}
    {#            <canvas id="myChart" style="width: 400px; height: 300px;"></canvas>        </div>#}

    {#    {% else %}#}
    {#        <p>No data available to display.</p>#}
    {#    {% endif %}#}
    <div class="card card-danger mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h3 class="card-title">Seller Sign-ups</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    <h4 id="Seller-signups">Total Sellers Signed Up:    {{ Sellercount }}</h4>
                </div>
            </div>
        </div>
        <!-- /.card-body -->
    </div>

    <div class="card card-success mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h3 class="card-title">Stacked Bar Chart</h3>


        </div>
        <div class="card-body">
            <div class="chart">
                {% if chart is not null %}

                    <div class="chart-container">
                        <canvas id="myChart" style="width: 400px; height: 300px;"></canvas>        </div>

                {% else %}
                    <p>No data available to display.</p>
                {% endif %}            </div>
        </div>
        <!-- /.card-body -->
    </div>


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        console.log('Chart Data:', {{ chart.data|json_encode|raw }});

        var ctx = document.getElementById('myChart').getContext('2d');
        var myChart = new Chart(ctx, {
            type: '{{ chart.type }}',
            data: {
                labels: {{ chart.data.labels|json_encode|raw }},
                datasets: [{
                    label: '{{ chart.data.datasets[0].label }}',
                    data: {{ chart.data.datasets[0].data|json_encode|raw }},
                    backgroundColor: '{{ chart.data.datasets[0].backgroundColor }}',
                    borderColor: '{{ chart.data.datasets[0].borderColor }}',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>

