{% extends 'layout_admin.html.twig'%}
{% block title %} admin Home {% endblock %}

{% block container %}

{% block javascripts %}
    {{ encore_entry_script_tags('dashboard') }}


{% endblock %}

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD Users - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fontawesome.com/icons/eye?f=classic&s=solid&pc=%231c71d8&sc=%231c71d8" rel="stylesheet">
       <link href= "https://fontawesome.com/icons/user-pen?f=duotone&s=thin&pc=%2357e389&sc=%2357e389 "rel="stylesheet">
<body>
    <div class="container mt-5">
        <h2 class="mb-4 text-danger text-center">Manage Clients</h2>
        <div class="card shadow-lg rounded-3 border-0">
            <div class="card-header bg-danger text-white text-center fw-bold">Clients List</div>
            <div class="card-body">
                <div class="mb-3 d-flex justify-content-between align-items-center">
       <div class="dropdown">
    <button class="btn btn-success dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="true">
        Add Client
    </button>
    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
        <li>
            <a class="dropdown-item" href="{{ path('admin_add_verified_client') }}">
                Add Verified Client
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="{{ path('admin_add_normal_client') }}">
                Add Normal Client
            </a>
        </li>
    </ul>
</div>


                   <div class="d-flex gap-2">
                        <select id="statusFilter" class="form-select w-auto">
                            <option value="">All Status</option>
                            <option value="Verified">Verified</option>
                            <option value="Not Verified">Not Verified</option>
                        </select>
                        <select id="idTypeFilter" class="form-select w-auto">
                            <option value="">All ID Types</option>
                            <option value="CIN">CIN</option>
                            <option value="Permit">Permit</option>
                            <option value="Bank Card">Bank Card</option>
                        </select>
                        <input type="text" id="searchBar" class="form-control w-auto" placeholder="Search clients...">
                    </div>
                </div>
                <table id="usersTable" class="table table-hover table-bordered text-center" style="width:100%">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>ID</th>
                            <th>Profile</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>ID Type</th>
                            <th>ID Number</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td><img src="https://via.placeholder.com/50" alt="John Doe" class="rounded-circle" width="50" height="50"></td>
                            <td>John Doe</td>
                            <td>john@example.com</td>
                            <td><span class="badge bg-success">Verified</span></td>
                            <td>CIN</td>
                            <td>12345678</td>
                            <td>
                                <button class="btn btn-info btn-sm me-1">View</button>
                                <button class="btn btn-warning btn-sm me-1">Edit</button>
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td><img src="https://via.placeholder.com/50" alt="Jane Smith" class="rounded-circle" width="50" height="50"></td>
                            <td>Jane Smith</td>
                            <td>jane@example.com</td>
                            <td><span class="badge bg-warning text-dark">Not Verified</span></td>
                            <td>-</td>
                            <td>-</td>
                            <td>
                                <button class="btn btn-info btn-sm me-1">View</button>
                                <button class="btn btn-warning btn-sm me-1">Edit</button>
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>



</body>




{% endblock %}
