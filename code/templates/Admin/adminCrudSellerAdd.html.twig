{% extends 'base.html.twig' %}

{% block container %}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="text-center">Add Seller</h1>
                <form method="post" action="{{ path('admin_sellers_add') }}" class="mt-4">
                    <div class="form-group mb-3">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" class="form-control" required>
                    </div>
                    <div class="form-group mb-3">
                        <label for="contactInfo">Contact Info</label>
                        <input type="text" id="contactInfo" name="contactInfo" class="form-control" required>
                    </div>
                    <div class="form-group mb-3">
                        <label for="phoneNumber">Phone Number</label>
                        <input type="text" id="phoneNumber" name="phoneNumber" class="form-control" required>
                    </div>
                    <div class="form-group mb-3">
                        <label for="garageAddress">Garage Address</label>
                        <input type="text" id="garageAddress" name="garageAddress" class="form-control" required>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Add Seller</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}