{% extends 'base.html.twig' %}

{% block container %}
    <h1>Login Mécanicien</h1>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}
        <button class="btn btn-primary">Connexion</button>
    {{ form_end(form) }}
{% endblock %}
