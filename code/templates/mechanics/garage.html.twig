{% extends 'base.html.twig' %}

{% block container %}
    <h2>Liste des Garages</h2>

    <ul>
        {% for garage in garages %}
            <li>
                <a href="{{ path('garage_show', {'id': garage.id}) }}">
                    {{ garage.name }}
                </a>
            </li>
        {% else %}
            <li>Aucun garage trouvé.</li>
        {% endfor %}
    </ul>
{% endblock %}
