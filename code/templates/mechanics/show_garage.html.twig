
{% block container %}

        <h1 class="title"> {{ mechanic.name }}'s garages</h1>

        {% if garages is empty %}
            <p class="alert-warning">Aucun garage trouvé pour ce mécanicien.</p>
        {% else %}
            <ul class="garage-list">
                {% for garage in garages %}
                    <li class="garage-item">
                        <div class="garage-info">
                            <strong>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13l2-2m0 0l7-7 7 7M13 5v6h6" />
                                </svg>
                                {{ garage.name }}
                            </strong>
                            📧 Email : <span class="email">{{ garage.emailGarage }}</span><br>
                            📊 Status : <span class="status">{{ garage.status }}</span><br>
                            ⭐ Rating : <span class="rating">{{ garage.rating }}</span>
                        </div>
                        <a href="{{ path('garage_show', {'id': garage.id}) }}" class="btn-primary">Voir détails</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
{% endblock %}

{% block stylesheets %}
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 30px;
            background-color: #1E1E1E;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(255, 255, 255, 0.05);
        }

        .title {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 30px;
            color: #D32F2F;
        }

        .garage-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            padding: 0;
            list-style: none;
        }

        .garage-item {
            background-color: #2A2A2A;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #333;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .garage-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.05);
        }

        .garage-info {
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .garage-info strong {
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: #fff;
        }

        .garage-info svg {
            width: 20px;
            height: 20px;
            stroke: #D32F2F;
        }

        .email, .status, .rating {
            font-weight: bold;
            color: #ccc;
        }

        .btn-primary {
            display: inline-block;
            background-color: #D32F2F;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.95rem;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #B71C1C;
        }

        .alert-warning {
            background-color: #2a0000;
            color: #ff7b7b;
            border-left: 5px solid #D32F2F;
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }

            .title {
                font-size: 2rem;
            }
        }
    </style>
{% endblock %}
