    {% extends 'layout_mechanics.html.twig' %}

    {% block container %}
    <div class="edit-profile-container">
        <h2>Edit Your Profile</h2>

        <div class="form-wrapper">
        {{ form_start(form) }}
            <div class="form-row">
            <div class="form-group">
                {{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
            </div>
            </div>

            <div class="form-row">
            <div class="form-group">
                {{ form_row(form.specialization, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_row(form.photoProfilFile, {'attr': {'class': 'form-control-file'}}) }}
            </div>
            </div>

            <div class="form-row">
            <div class="form-group">
                {{ form_row(form.submit, {'attr': {'class': 'btn btn-submit'}}) }}
            </div>
            </div>
        {{ form_end(form) }}
        </div>
    </div>

    {% block stylesheets %}
        <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        .edit-profile-container {
            max-width: 700px;
            margin: 50px auto;
            padding: 40px;
            background-color: #111;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            color: #eaeaea;
            font-family: 'Roboto', sans-serif;
            transition: all 0.3s ease;
        }

        h2 {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 700;
            color: #ff5733; /* A brighter orange-red */
            margin-bottom: 20px;
        }

        .form-wrapper {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .form-row {
            display: flex;
            gap: 30px;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .form-group {
            flex: 1;
            min-width: 200px;
            margin-bottom: 20px;
        }

        .form-control {
            width: 100%;
            padding: 15px;
            font-size: 16px;
            background-color: #222;
            color: #eaeaea;
            border: 2px solid #444;
            border-radius: 10px;
            transition: all 0.4s ease;
        }

        .form-control:focus {
            border-color: #ff5733;
            background-color: #333;
            box-shadow: 0 0 10px rgba(255, 87, 51, 0.6);
        }

        .form-control-file {
            width: 100%;
            padding: 15px;
            font-size: 16px;
            background-color: #222;
            color: #eaeaea;
            border: 2px solid #444;
            border-radius: 10px;
            transition: all 0.4s ease;
        }

        .form-control-file:focus {
            border-color: #ff5733;
            background-color: #333;
            box-shadow: 0 0 10px rgba(255, 87, 51, 0.6);
        }

        .btn-submit {
            width: 100%;
            padding: 15px;
            font-size: 18px;
            background-color: #ff5733;
            color: white;
            border: none;
            border-radius: 15px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.3s ease;
        }

        .btn-submit:hover {
            background-color: #c03e2c; /* Darker shade of red */
            transform: scale(1.05);
        }

        .btn-submit:active {
            background-color: #d94f36; /* Slightly more intense red */
        }

        /* Fancy shadow effect */
        .edit-profile-container:hover {
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
        }

        .form-row .form-group {
            transition: transform 0.3s ease;
        }

        .form-row .form-group:hover {
            transform: translateY(-5px);
        }

        @media (max-width: 768px) {
            .edit-profile-container {
            padding: 30px;
            width: 90%;
            }

            .form-row {
            flex-direction: column;
            }

            .form-group {
            width: 100%;
            }
        }
        </style>
    {% endblock %}
    {% endblock %}
