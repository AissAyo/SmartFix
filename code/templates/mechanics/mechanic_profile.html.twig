{% extends 'layout_mechanics.html.twig' %}

{% block container %}
  <div class="profile-container">
    <div class="profile-header">
      <div class="profile-photo">
        {% if mechanic.photoProfil %}
<img src="{{ asset('admin/dist/img/avatar.png') }}" alt="Profile Picture" class="profile-img" />
        {% else %}
          <img src="{{ asset('img/default-avatar.png') }}" alt="Default Profile" class="profile-img" />
        {% endif %}
      </div>
      <div class="profile-details">
        <h2>{{ mechanic.name }}</h2>
        <p class="role">{{ mechanic.roles | join(', ') }}</p>
        <a href="{{ path('mechanic_edit', { id: mechanic.id }) }}" class="edit-btn">✏️ Edit Profile</a> <!-- Bouton d'édition -->
      </div>
    </div>

    <div class="profile-info">
      <div class="info-section">
        <h3>Details</h3>
        <div><strong>Email :</strong> {{ mechanic.email }}</div>
        <div><strong>City :</strong> {{ mechanic.city }}</div>
        <div><strong>Adresse :</strong> {{ mechanic.address }}</div>
      </div>

      <div class="info-section">
        <h3>personnel informations :</h3>
        <div><strong>Specialisation :</strong> {{ mechanic.specialization }}</div>
        <div><strong>Years of experience :</strong> {{ mechanic.experienceYears }}</div>
        <div><strong>Certifications :</strong> {{ mechanic.certifications ? mechanic.certifications : 'Non disponible' }}</div>
      </div>

      
    </div>
  </div>

  {% block stylesheets %}
    <style>
      /* Global styles */
      body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #121212;
        color: #f5f5f5;
        margin: 0;
        padding: 0;
      }

      .profile-container {
        max-width: 900px;
        margin: 30px auto;
        padding: 20px;
        background-color: #1e1e1e;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      }

      .profile-header {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 40px;
        border-bottom: 2px solid #333;
        padding-bottom: 20px;
      }

      .profile-photo {
        flex-shrink: 0;
        margin-right: 20px;
      }

      .profile-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #c90000;
        transition: all 0.3s ease;
      }

      .profile-img:hover {
        transform: scale(1.1);
        box-shadow: 0 5px 15px rgba(201, 0, 0, 0.5);
      }

      .profile-details h2 {
        font-size: 30px;
        color: #ff4d4d;
        margin: 0;
      }

      .profile-details .role {
        color: #bbb;
        font-size: 18px;
      }

      .profile-details .edit-btn {
        display: inline-block;
        margin-top: 10px;
        padding: 10px 20px;
        background-color: #c90000;
        color: #fff;
        font-weight: bold;
        border-radius: 5px;
        text-decoration: none;
        transition: background-color 0.3s ease;
      }

      .profile-details .edit-btn:hover {
        background-color: #ff4d4d;
      }

      .profile-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
      }

      .info-section {
        background-color: #2c2c2c;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
      }

      .info-section:hover {
        background-color: #333;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }

      .info-section h3 {
        color: #ff4d4d;
        margin-bottom: 15px;
        font-size: 22px;
      }

      .info-section div {
        margin-bottom: 10px;
        font-size: 16px;
      }

      .info-section strong {
        color: #c90000;
      }

      .small-img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        margin-top: 10px;
        border: 2px solid #c90000;
      }

      /* Hover effect for small images */
      .small-img:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 12px rgba(201, 0, 0, 0.4);
      }
    </style>
  {% endblock %}
{% endblock %}
