{% extends 'layout_mechanics.html.twig' %}
{% block container %}


{% block stylesheets %}
<style>
    <link rel="stylesheet" href="{{ asset('css') }}">

    body {
        background-color: #0d0d0d;
        font-family: 'Segoe UI', sans-serif;
        color: #f5f5f5;
        padding: 20px;
    }

    h2 {
        color:rgb(161, 36, 36);
        text-align: center;
        margin-bottom: 30px;
        font-size: 26px;
            padding-bottom: 10px;
    }

    .mechanic-info {
        max-width: 800px;
        margin: auto;
        background-color: #1a1a1a;
        padding: 25px 30px;
        border-radius: 10px;
        border: 1px solid #c90000;
        box-shadow: 0 5px 18px rgba(201, 0, 0, 0.3);
    }

    .mechanic-info > div {
        margin-bottom: 15px;
        padding: 8px;
        border-bottom: 1px solid #333;
    }

    .mechanic-info strong {
        color: #ff4d4d;
        display: inline-block;
        width: 200px;
    }

    .mechanic-info img {
        max-width: 150px;
        max-height: 150px;
        border-radius: 8px;
        border: 2px solid #c90000;                              
        margin-top: 8px;
    }

    .mechanic-info p {
        margin: 0;
        color: #bbb;
    }
</style>
{% endblock %}



{# {% block container %} #}
<h2>Profile                             </h2>
<div style="text-align: center; margin-top: 20px;">
    <a href="{{ path('mechanic_edit', { id: mechanic.id }) }}" 
       class="btn-edit-mechanic">
        ✏️ Edit Profile
    </a>
</div>

<div class="mechanic-info">
    <div><strong>Full name : </strong> {{ mechanic.name }}</div>
    <div><strong>Email:</strong> {{ mechanic.email }}</div>
    <div><strong>Phone Number : </strong> {{ mechanic.phoneNumber }}</div>
    <div><strong>City :</strong> {{ mechanic.city }}</div>
    <div><strong>Address :</strong> {{ mechanic.address }}</div>
    <div><strong>Role : </strong> {{ mechanic.roles }}</div>
    <div><strong>Profile Picture </strong>
        {% if mechanic.photoProfil %}
            <img src="{{ asset('img/avatar/' ~ mechanic.photoProfil) }}" alt="" />
        {% else %}
            <p>Aucune photo de profil disponible.</p>
        {% endif %}
    </div>
    <div><strong>Spécialisation:</strong> {{ mechanic.specialization }}</div>
    <div><strong>Années d'expérience:</strong> {{ mechanic.experienceYears }}</div>
    <div><strong>Certifications:</strong> {{ mechanic.certifications }}</div>
    <div><strong>Logo:</strong>
        {% if mechanic.logoFile %}
            <img src="{{ asset('img/avatar/' ~ mechanic.logo) }}" alt="Logo" />
        {% else %}
            <p>Aucun logo disponible.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
