<!-- Styles CSS -->
<style>
  .nav-item .nav-link.clickable {
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s;
  }

  .nav-item .nav-link.clickable:hover {
    background-color: #f0f0f0;
    color: #007bff;
  }

  .nav-item .nav-treeview {
    padding-left: 20px;
  }

  /* Ajout de styles pour les sous-boutons */
  .nav-item .nav-link .fas, .nav-item .nav-link .far {
    margin-right: 5px;
  }

  .nav-item .nav-link .right {
    margin-left: auto;
  }

  /* Styles pour mieux visualiser les sous-menus */
  .nav-item .nav-treeview {
    display: none;
    padding-left: 20px;
  }

  .nav-item:hover > .nav-treeview {
    display: block;
  }

  /* Change de couleur lors du survol d'un sous-menu */
  .nav-item:hover > .nav-link {
    background-color: #f0f0f0;
    color: #007bff;
  }
</style>

<script>
  // Script pour basculer l'affichage des sous-menus
  document.querySelectorAll('.nav-item.has-treeview > a').forEach(item => {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      const submenu = this.nextElementSibling;
      submenu.style.display = submenu.style.display === 'none' ? 'block' : 'none';
    });
  });

  // Script pour basculer les sous-sous-menus
  document.querySelectorAll('.nav-item > a').forEach(item => {
    item.addEventListener('click', function(e) {
      const nestedSubmenu = this.nextElementSibling;
      if (nestedSubmenu) {
        nestedSubmenu.style.display = nestedSubmenu.style.display === 'none' ? 'block' : 'none';
      }
    });
  });
</script>





          
